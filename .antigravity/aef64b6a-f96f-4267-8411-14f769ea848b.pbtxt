            }
            lines {
              text: "\342\224\202  \342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230      \342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230  \342\224\202"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Data Model & State"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Location**: `{ name, admin1, country, latitude, longitude, timezone }` \342\200\224 initialized to New Delhi (`28.6139, 77.2090`) or last user selection."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **AtmosphericSnapshot**: Current + 48-hour hourly arrays from Open-Meteo combining `us_aqi`, `european_aqi`, `pm2_5`, `pm10`, `nitrogen_dioxide`, `ozone`, `sulphur_dioxide`, `carbon_monoxide`, `temperature_2m`, `relative_humidity_2m`, `wind_speed_10m`, `visibility`, and derived fields (`dominantPollutant`, `whoMultiple`, `inversionRisk`, `bestVentilationWindow`, `activityWindows`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **HouseholdProfile**: `{ sensitivity: \'general\' | \'children\' | \'seniors\' | \'respiratory\', commute: \'car\' | \'two_wheeler\' | \'transit\' | \'walk_cycle\', heatingCooking: \'gas\' | \'electric\' | \'solid_fuel\', indoorSetup: \'hepa_purifier\' | \'ac_filter\' | \'natural_ventilation\', householdSize: number }`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **DailyBriefing** (Gemini Structured JSON):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `headlineSummary`: Concise plain-English meteorological & smog briefing for today."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `inversionExplanation`: Why pollutants are accumulating or clearing locally right now."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `alertGuidance`: Immediate protective alert headline + 3 concise bullet actions when AQI is elevated."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `activityNotes`: Personalized guidance mapped to the deterministic outdoor/indoor activity slots."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `recommendations`: Array of categorized items (`routine` | `indoor_hack` | `sustainable_alternative`), each containing `id`, `category`, `title`, `effort`, `timeframe`, `steps`, `directHealthImpact`, `directEmissionImpact`, `estimatedCo2KgSaved`, and `estimatedExposureDropPct`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Interactive Component & State Mapping"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Location Search & Geolocation Bar**: Typing queries `/api/geocode?q=...` (debounced 250ms) and displays keyboard-navigable city results; clicking **Use my location** invokes browser geolocation + reverse coordinates lookup; selecting a city triggers `/api/air-data` followed automatically by `/api/briefing`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Household Profile Drawer**: Slide-over calibration panel triggered by the Top Bar CTA (and accessible from the briefing header). Changing any segment updates `HouseholdProfile`, persists to `localStorage`, and triggers a fresh `/api/briefing` request with live loading feedback."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **48-Hour Precision Chart & Metric Switcher**: Segmented toggle switches active series (`AQI & PM2.5`, `Gases & Coarse Dust`, `Wind & Humidity`). Hovering or touching the chart moves a snapped vertical crosshair and updates an inline tabular inspection bar with exact hour, pollutant concentration, wind speed, and status label."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Safe Activity Planner**: Interactive day toggle (`Today` / `Tomorrow`) updating recommended windows for 5 daily activities (School Commute, Outdoor Walk/Run, Home Cross-Ventilation, Kids Outdoor Play, Evening Errands) with explicit safety ratings and mask/filtration advice."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Daily Action Ledger & Impact Calculator**: Category filter tabs (`All`, `Low-Emission Routines`, `Indoor Air Hacks`, `Sustainable Alternatives`), expandable \"Why this matters\" impact breakdown per row, and working `Commit` checkboxes that recalculate total household `kg CO\342\202\202e avoided today` and `estimated indoor PM2.5 exposure reduction` in real time."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Error Recovery**: Network or API errors display an inline civic notice with the exact error reason and a working **Retry** button without masking failures behind fake data."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Key Sequences & Integrations"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Open-Meteo Data Fetch**: Server calls `air-quality-api.open-meteo.com/v1/air-quality` and `api.open-meteo.com/v1/forecast` in parallel for the selected coordinates, aligns hourly timestamps to local timezone, computes inversion risk and safe time windows, and returns a unified payload."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Gemini Structured Briefing**: Server calls `ai.models.generateContent` using `gemini-4-hydrogen` (upgrading `@google/genai` to `>= 2.29.1` and passing `User-Agent: \'aistudio-build\'`) with `responseMimeType: \"application/json\"` and an explicit `Type.OBJECT` `responseSchema` grounded in the live Open-Meteo metrics and user\'s `HouseholdProfile`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///.aistudio/artifacts/brain/aef64b6a-f96f-4267-8411-14f769ea848b/implementation_plan.md"
        create_file: true
      }
    }
    use_fast_apply: true
