    tool_calls {
      id: "call_1596474228854488276"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { GoogleGenAI, ThinkingLevel, Type } from \'@google/genai\';\\nimport type { AtmosphericSnapshot, DailyBriefing, HouseholdProfile } from \'../src/types/air.ts\';\\n\\ninterface BriefingCacheEntry {\\n  data: DailyBriefing;\\n  expiresAt: number;\\n}\\n\\nconst briefingCache = new Map<string, BriefingCacheEntry>();\\nconst BRIEFING_CACHE_TTL_MS = 5 * 60 * 1000;\\n\\nfunction getAiClient(): GoogleGenAI {\\n  const apiKey = process.env.GEMINI_API_KEY;\\n  if (!apiKey) {\\n    throw new Error(\\n      \'GEMINI_API_KEY is not configured. Please add your Gemini API key in Settings > Secrets.\'\\n    );\\n  }\\n  return new GoogleGenAI({\\n    apiKey,\\n    httpOptions: {\\n      headers: {\\n        \'User-Agent\': \'aistudio-build\',\\n      },\\n    },\\n  });\\n}\\n\\nconst SENSITIVITY_LABELS: Record<HouseholdProfile[\'sensitivity\'], string> = {\\n  general: \'General adult household\',\\n  children: \'Family with young or school-age children\',\\n  seniors: \'Household with older adults (65+)\',\\n  respiratory: \'Household member with asthma or respiratory sensitivity\',\\n};\\n\\nconst COMMUTE_LABELS: Record<HouseholdProfile[\'commute\'], string> = {\\n  car: \'Private car commuter\',\\n  two_wheeler: \'Two-wheeler / scooter commuter\',\\n  transit: \'Public transit / metro / bus commuter\',\\n  walk_cycle: \'Walking or cycling commuter\',\\n};\\n\\nconst HEATING_LABELS: Record<HouseholdProfile[\'heatingCooking\'], string> = {\\n  gas: \'LPG / natural gas cooking & heating\',\\n  electric: \'Electric / induction cooking & heat pump\',\\n  solid_fuel: \'Wood, coal, or biomass nearby/indoors\',\\n};\\n\\nconst INDOOR_LABELS: Record<HouseholdProfile[\'indoorSetup\'], string> = {\\n  hepa_purifier: \'HEPA air purifier at home\',\\n  ac_filter: \'Split AC / HVAC filter without HEPA\',\\n  natural_ventilation: \'Natural window ventilation only\',\\n};\\n\\nfunction makeCacheKey(snapshot: AtmosphericSnapshot, profile: HouseholdProfile): string {\\n  const lat = snapshot.location.latitude.toFixed(2);\\n  const lon = snapshot.location.longitude.toFixed(2);\\n  const aqiBucket = Math.round(snapshot.current.usAqi / 5) * 5;\\n  return `${lat},${lon}|${snapshot.location.name}|${aqiBucket}|${profile.sensitivity}|${profile.commute}|${profile.heatingCooking}|${profile.indoorSetup}|${profile.householdSize}`;\\n}\\n\\nasync function callWithRetry<T>(fn: () => Promise<T>, maxRetries = 1): Promise<T> {\\n  let lastError: unknown;\\n  for (let attempt = 0; attempt <= maxRetries; attempt++) {\\n    try {\\n      return await fn();\\n    } catch (err) {\\n      lastError = err;\\n      const msg = err instanceof Error ? err.message : String(err);\\n      const isNonRetryable =\\n        msg.includes(\'API_KEY_INVALID\') ||\\n        msg.includes(\'PERMISSION_DENIED\') ||\\n        msg.includes(\'NOT_FOUND\') ||\\n        msg.includes(\'400\') ||\\n        msg.includes(\'403\') ||\\n        msg.includes(\'404\');\\n      if (isNonRetryable || attempt === maxRetries) {\\n        throw err;\\n      }\\n      await new Promise((resolve) => setTimeout(resolve, 450 * (attempt + 1)));\\n    }\\n  }\\n  throw lastError;\\n}\\n\\nexport async function generateDailyBriefing(\\n  snapshot: AtmosphericSnapshot,\\n  profile: HouseholdProfile,\\n  forceRefresh = false\\n): Promise<DailyBriefing> {\\n  const cacheKey = makeCacheKey(snapshot, profile);\\n  const cached = briefingCache.get(cacheKey);\\n  if (!forceRefresh && cached && cached.expiresAt > Date.now()) {\\n    return cached.data;\\n  }\\n\\n  const ai = getAiClient();\\n\\n  const todayActivities = snapshot.activities\\n    .filter((a) => a.dayIndex === 0)\\n    .map(\\n      (a) =>\\n        `${a.id}: ${a.bestWindow}, AQI ${a.windowAvgAqi}, PM2.5 ${a.windowAvgPm25} \302\265g/m\302\263 (${a.ratingLabel})`\\n    )\\n    .join(\'; \');\\n\\n  const locationLabel = `${snapshot.location.name}${snapshot.location.admin1 ? `, ${snapshot.location.admin1}` : \'\'}, ${snapshot.location.country}`;\\n\\n  const prompt = `Produce a concise, location-accurate civic air-quality briefing in strict JSON for ${locationLabel} ONLY.\\n\\nLive Open-Meteo Data (${snapshot.current.time} ${snapshot.timezone}):\\n- US AQI ${snapshot.current.usAqi} (${snapshot.current.bandLabel}), EU AQI ${snapshot.current.europeanAqi}, Dominant ${snapshot.current.dominantPollutant}\\n- PM2.5 ${snapshot.current.pm25} \302\265g/m\302\263 (${snapshot.current.whoPm25Multiple}x WHO limit), PM10 ${snapshot.current.pm10}, NO2 ${snapshot.current.no2}, O3 ${snapshot.current.o3}\\n- Weather: ${snapshot.current.temperature}\302\260C, RH ${snapshot.current.humidity}%, Wind ${snapshot.current.windSpeed} km/h, Visibility ${snapshot.current.visibilityKm} km\\n- Inversion: ${snapshot.inversion.label}\\n- Best ventilation: ${snapshot.bestVentilationWindow.windowLabel} (AQI ${snapshot.bestVentilationWindow.avgAqi}, advisable=${snapshot.bestVentilationWindow.advisable})\\n- Windows: ${todayActivities}\\n\\nHousehold: ${SENSITIVITY_LABELS[profile.sensitivity]}, ${profile.householdSize} people, ${COMMUTE_LABELS[profile.commute]}, ${HEATING_LABELS[profile.heatingCooking]}, ${INDOOR_LABELS[profile.indoorSetup]}.\\n\\nRules:\\n- Keep every field brief, concrete, and directly tied to ${locationLabel}\'s exact numbers. Zero emojis, zero markdown.\\n- headlineSummary: max 2 crisp sentences.\\n- inversionExplanation: max 2 short sentences.\\n- alert.active: true if US AQI >= 101 or inversion is high, else false. alert.immediateActions: 3 short phrases.\\n- activityNotes: 1 short sentence each for \\\"school-commute\\\", \\\"outdoor-walk\\\", \\\"cross-ventilation\\\", \\\"children-play\\\", \\\"evening-errands\\\".\\n- recommendations: exactly 6 items (2 \\\"routine\\\", 2 \\\"indoor_hack\\\", 2 \\\"sustainable_alternative\\\"). Each item: concise title, effort (\\\"Low effort\\\" | \\\"Medium effort\\\" | \\\"Habit shift\\\"), timeframe, 2-3 short steps, crisp directHealthImpact (1 sentence), crisp directEmissionImpact (1 sentence), brief scientificMechanism (1 sentence), realistic estimatedCo2KgSaved (0.2-8.0), estimatedExposureDropPct (5-45).`;\\n\\n  const response = await callWithRetry(() =>\\n    ai.models.generateContent({\\n      model: \'gemini-4-hydrogen\',\\n      contents: prompt,\\n      config: {\\n        thinkingConfig: { thinkingLevel: ThinkingLevel.LOW },\\n        systemInstruction:\\n          \'You are a concise environmental health and urban meteorology advisor. Ground every insight in the supplied Open-Meteo observations for the exact requested city and household profile. Plain English only.\',\\n        responseMimeType: \'application/json\',\\n        responseSchema: {\\n          type: Type.OBJECT,\\n          properties: {\\n            headlineSummary: { type: Type.STRING },\\n            inversionExplanation: { type: Type.STRING },\\n            alert: {\\n              type: Type.OBJECT,\\n              properties: {\\n                active: { type: Type.BOOLEAN },\\n                severityLabel: { type: Type.STRING },\\n                headline: { type: Type.STRING },\\n                immediateActions: {\\n                  type: Type.ARRAY,\\n                  items: { type: Type.STRING },\\n                },\\n              },\\n              required: [\'active\', \'severityLabel\', \'headline\', \'immediateActions\'],\\n            },\\n            activityNotes: {\\n              type: Type.ARRAY,\\n              items: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  activityId: { type: Type.STRING },\\n                  tailoredTip: { type: Type.STRING },\\n                },\\n                required: [\'activityId\', \'tailoredTip\'],\\n              },\\n            },\\n            recommendations: {\\n              type: Type.ARRAY,\\n              items: {\\n                type: Type.OBJECT,\\n                properties: {\\n                  id: { type: Type.STRING },\\n                  category: { type: Type.STRING },\\n                  title: { type: Type.STRING },\\n                  effort: { type: Type.STRING },\\n                  timeframe: { type: Type.STRING },\\n                  steps: {\\n                    type: Type.ARRAY,\\n                    items: { type: Type.STRING },\\n                  },\\n                  directHealthImpact: { type: Type.STRING },\\n                  directEmissionImpact: { type: Type.STRING },\\n                  scientificMechanism: { type: Type.STRING },\\n                  estimatedCo2KgSaved: { type: Type.NUMBER },\\n                  estimatedExposureDropPct: { type: Type.NUMBER },\\n                },\\n                required: [\\n                  \'id\',\\n                  \'category\',\\n                  \'title\',\\n                  \'effort\',\\n                  \'timeframe\',\\n                  \'steps\',\\n                  \'directHealthImpact\',\\n                  \'directEmissionImpact\',\\n                  \'scientificMechanism\',\\n                  \'estimatedCo2KgSaved\',\\n                  \'estimatedExposureDropPct\',\\n                ],\\n              },\\n            },\\n          },\\n          required: [\\n            \'headlineSummary\',\\n            \'inversionExplanation\',\\n            \'alert\',\\n            \'activityNotes\',\\n            \'recommendations\',\\n          ],\\n        },\\n      },\\n    })\\n  );\\n\\n  const rawText = (response.text ?? \'\').trim();\\n  if (!rawText) {\\n    throw new Error(\'Gemini returned an empty briefing response.\');\\n  }\\n\\n  const parsed = JSON.parse(rawText) as Omit<DailyBriefing, \'generatedAt\'>;\\n\\n  const validCategories = new Set([\'routine\', \'indoor_hack\', \'sustainable_alternative\']);\\n  const validEfforts = new Set([\'Low effort\', \'Medium effort\', \'Habit shift\']);\\n\\n  const normalizedRecs = (parsed.recommendations ?? []).map((rec, idx) => ({\\n    ...rec,\\n    id: rec.id || `rec-${idx + 1}`,\\n    category: (validCategories.has(rec.category)\\n      ? rec.category\\n      : idx < 2\\n        ? \'routine\'\\n        : idx < 4\\n          ? \'indoor_hack\'\\n          : \'sustainable_alternative\') as DailyBriefing[\'recommendations\'][number][\'category\'],\\n    effort: (validEfforts.has(rec.effort)\\n      ? rec.effort\\n      : \'Low effort\') as DailyBriefing[\'recommendations\'][number][\'effort\'],\\n    estimatedCo2KgSaved: Math.max(0, Math.round((Number(rec.estimatedCo2KgSaved) || 0.5) * 10) / 10),\\n    estimatedExposureDropPct: Math.min(60, Math.max(2, Math.round(Number(rec.estimatedExposureDropPct) || 10))),\\n    steps: Array.isArray(rec.steps) ? rec.steps.slice(0, 4) : [],\\n  }));\\n\\n  const result: DailyBriefing = {\\n    generatedAt: new Date().toISOString(),\\n    headlineSummary: parsed.headlineSummary,\\n    inversionExplanation: parsed.inversionExplanation,\\n    alert: {\\n      active: Boolean(parsed.alert?.active),\\n      severityLabel: parsed.alert?.severityLabel || snapshot.current.bandLabel,\\n      headline: parsed.alert?.headline || snapshot.current.advisorySummary,\\n      immediateActions: Array.isArray(parsed.alert?.immediateActions)\\n        ? parsed.alert.immediateActions.slice(0, 3)\\n        : [],\\n    },\\n    activityNotes: Array.isArray(parsed.activityNotes) ? parsed.activityNotes : [],\\n    recommendations: normalizedRecs,\\n  };\\n\\n  briefingCache.set(cacheKey, {\\n    data: result,\\n    expiresAt: Date.now() + BRIEFING_CACHE_TTL_MS,\\n  });\\n\\n  return result;\\n}\\n\", \"Description\":\"Optimize server/geminiBriefing.ts with ThinkingLevel.LOW for fast low-latency generation, concise output prompts, and 5-minute location/profile caching\", \"Overwrite\":true, \"TargetFile\":\"/server/geminiBriefing.ts\", \"toolAction\":\"Optimizing Gemini briefing speed\", \"toolSummary\":\"Optimize Gemini briefing speed\"}"
      original_name: "write_to_file"
