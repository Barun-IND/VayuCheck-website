    tool_calls {
      id: "call_16478336989770058959"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type {\\n  ActivityRating,\\n  AqiBand,\\n  HouseholdProfile,\\n  InversionRiskLevel,\\n  LocationInfo,\\n  PollutantBreakdown,\\n  RecommendationCategory,\\n} from \'../types/air\';\\n\\nexport const DEFAULT_CITY: LocationInfo = {\\n  name: \'New Delhi\',\\n  admin1: \'Delhi\',\\n  country: \'India\',\\n  latitude: 28.6139,\\n  longitude: 77.209,\\n  timezone: \'Asia/Kolkata\',\\n};\\n\\nexport const PRESET_CITIES: LocationInfo[] = [\\n  DEFAULT_CITY,\\n  {\\n    name: \'Lahore\',\\n    admin1: \'Punjab\',\\n    country: \'Pakistan\',\\n    latitude: 31.5204,\\n    longitude: 74.3587,\\n  },\\n  {\\n    name: \'Beijing\',\\n    admin1: \'Beijing\',\\n    country: \'China\',\\n    latitude: 39.9042,\\n    longitude: 116.4074,\\n  },\\n  {\\n    name: \'Milan\',\\n    admin1: \'Lombardy\',\\n    country: \'Italy\',\\n    latitude: 45.4642,\\n    longitude: 9.19,\\n  },\\n  {\\n    name: \'London\',\\n    admin1: \'England\',\\n    country: \'United Kingdom\',\\n    latitude: 51.5072,\\n    longitude: -0.1276,\\n  },\\n  {\\n    name: \'Los Angeles\',\\n    admin1: \'California\',\\n    country: \'United States\',\\n    latitude: 34.0522,\\n    longitude: -118.2437,\\n  },\\n];\\n\\nexport const DEFAULT_PROFILE: HouseholdProfile = {\\n  sensitivity: \'children\',\\n  commute: \'car\',\\n  heatingCooking: \'gas\',\\n  indoorSetup: \'natural_ventilation\',\\n  householdSize: 4,\\n};\\n\\nexport function getAqiTone(band: AqiBand): {\\n  textClass: string;\\n  glyph: string;\\n  stroke: string;\\n  surfaceTint: string;\\n  borderTint: string;\\n} {\\n  switch (band) {\\n    case \'good\':\\n      return {\\n        textClass: \'text-[#2D6A4F]\',\\n        glyph: \'\342\227\217\',\\n        stroke: \'#2D6A4F\',\\n        surfaceTint: \'bg-[#F2F7F4]\',\\n        borderTint: \'border-[#C8DFD3]\',\\n      };\\n    case \'moderate\':\\n      return {\\n        textClass: \'text-[#9A6B16]\',\\n        glyph: \'\342\227\206\',\\n        stroke: \'#9A6B16\',\\n        surfaceTint: \'bg-[#FAF6EC]\',\\n        borderTint: \'border-[#E6D7B5]\',\\n      };\\n    case \'sensitive\':\\n      return {\\n        textClass: \'text-[#B84A27]\',\\n        glyph: \'\342\226\262\',\\n        stroke: \'#B84A27\',\\n        surfaceTint: \'bg-[#FBF3EF]\',\\n        borderTint: \'border-[#E9CBC0]\',\\n      };\\n    case \'unhealthy\':\\n      return {\\n        textClass: \'text-[#B84A27]\',\\n        glyph: \'\342\226\262\',\\n        stroke: \'#B84A27\',\\n        surfaceTint: \'bg-[#FAF1ED]\',\\n        borderTint: \'border-[#E5BFB1]\',\\n      };\\n    case \'very_unhealthy\':\\n    case \'hazardous\':\\n      return {\\n        textClass: \'text-[#7F1D1D]\',\\n        glyph: \'\342\226\240\',\\n        stroke: \'#7F1D1D\',\\n        surfaceTint: \'bg-[#F9EFEF]\',\\n        borderTint: \'border-[#E2BDBD]\',\\n      };\\n  }\\n}\\n\\nexport function getInversionTone(risk: InversionRiskLevel): {\\n  textClass: string;\\n  glyph: string;\\n} {\\n  switch (risk) {\\n    case \'high\':\\n      return { textClass: \'text-[#7F1D1D]\', glyph: \'\342\226\240\' };\\n    case \'moderate\':\\n      return { textClass: \'text-[#9A6B16]\', glyph: \'\342\226\262\' };\\n    case \'low\':\\n      return { textClass: \'text-[#2D6A4F]\', glyph: \'\342\227\217\' };\\n  }\\n}\\n\\nexport function getActivityTone(rating: ActivityRating): {\\n  textClass: string;\\n  glyph: string;\\n} {\\n  switch (rating) {\\n    case \'recommended\':\\n      return { textClass: \'text-[#2D6A4F]\', glyph: \'\342\227\217\' };\\n    case \'caution\':\\n      return { textClass: \'text-[#9A6B16]\', glyph: \'\342\227\206\' };\\n    case \'limit\':\\n      return { textClass: \'text-[#B84A27]\', glyph: \'\342\226\262\' };\\n    case \'avoid\':\\n      return { textClass: \'text-[#7F1D1D]\', glyph: \'\342\226\240\' };\\n  }\\n}\\n\\nexport function getPollutantStatusTone(status: PollutantBreakdown[\'status\']): {\\n  label: string;\\n  textClass: string;\\n} {\\n  switch (status) {\\n    case \'within\':\\n      return { label: \'Within WHO\', textClass: \'text-[#2D6A4F]\' };\\n    case \'elevated\':\\n      return { label: \'Above WHO\', textClass: \'text-[#9A6B16]\' };\\n    case \'high\':\\n      return { label: \'High\', textClass: \'text-[#B84A27]\' };\\n    case \'severe\':\\n      return { label: \'Severe\', textClass: \'text-[#7F1D1D]\' };\\n  }\\n}\\n\\nexport const CATEGORY_LABELS: Record<RecommendationCategory, string> = {\\n  routine: \'Low-Emission Routine\',\\n  indoor_hack: \'Indoor Air Hack\',\\n  sustainable_alternative: \'Sustainable Alternative\',\\n};\\n\\nexport const PROFILE_DISPLAY = {\\n  sensitivity: {\\n    general: \'General household\',\\n    children: \'With children\',\\n    seniors: \'With seniors (65+)\',\\n    respiratory: \'Asthma / respiratory\',\\n  },\\n  commute: {\\n    car: \'Car commute\',\\n    two_wheeler: \'Two-wheeler\',\\n    transit: \'Public transit\',\\n    walk_cycle: \'Walk or cycle\',\\n  },\\n  heatingCooking: {\\n    gas: \'Gas stove / heating\',\\n    electric: \'Electric / induction\',\\n    solid_fuel: \'Wood / biomass nearby\',\\n  },\\n  indoorSetup: {\\n    hepa_purifier: \'HEPA purifier\',\\n    ac_filter: \'AC filter only\',\\n    natural_ventilation: \'Natural ventilation\',\\n  },\\n} as const;\\n\\nexport function formatLocalObsTime(isoLike: string): string {\\n  if (!isoLike) return \'\342\200\224\';\\n  const [datePart, timePart] = isoLike.split(\'T\');\\n  if (!timePart) return isoLike;\\n  return `${datePart} \302\267 ${timePart.slice(0, 5)} local`;\\n}\\n\", \"Description\":\"Create semantic air quality tone utilities, preset cities, and household profile label dictionaries\", \"Overwrite\":true, \"TargetFile\":\"/src/lib/airStyle.ts\", \"toolAction\":\"Writing air style and domain helpers\", \"toolSummary\":\"Write domain helpers\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16478336989770056088"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { SlidersHorizontal } from \'lucide-react\';\\n\\ninterface TopBarProps {\\n  onOpenProfile: () => void;\\n}\\n\\nconst NAV_LINKS = [\\n  { href: \'#overview\', label: \'Overview\' },\\n  { href: \'#forecast\', label: \'Forecast\' },\\n  { href: \'#planner\', label: \'Activity Planner\' },\\n  { href: \'#briefing\', label: \'Daily Actions\' },\\n];\\n\\nexport function TopBar({ onOpenProfile }: TopBarProps) {\\n  return (\\n    <header className=\\\"sticky top-0 z-30 border-b border-[#E2DDD3] bg-[#F7F5F0]/95 backdrop-blur-sm\\\">\\n      <div className=\\\"mx-auto flex h-16 max-w-[1240px] items-center justify-between gap-8 px-4 sm:px-6 lg:px-8\\\">\\n        <a\\n          href=\\\"#overview\\\"\\n          className=\\\"font-display text-lg font-semibold tracking-tight text-[#181715] whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4E43]\\\"\\n        >\\n          Air Almanac\\n        </a>\\n\\n        <nav\\n          aria-label=\\\"Primary sections\\\"\\n          className=\\\"hidden md:flex items-center gap-7 text-sm font-medium text-[#5E5A52]\\\"\\n        >\\n          {NAV_LINKS.map((link) => (\\n            <a\\n              key={link.href}\\n              href={link.href}\\n              className=\\\"py-1 whitespace-nowrap shrink-0 transition-colors duration-150 hover:text-[#181715] hover:underline hover:underline-offset-6 hover:decoration-[#1F4E43] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F4E43]\\\"\\n            >\\n              {link.label}\\n            </a>\\n          ))}\\n        </nav>\\n\\n        <div className=\\\"flex items-center shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenProfile}\\n            className=\\\"inline-flex h-10 items-center gap-2 rounded-md bg-[#1F4E43] px-4 py-2 text-sm font-medium text-white whitespace-nowrap shrink-0 transition-colors duration-150 hover:bg-[#173C33] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1F4E43] cursor-pointer\\\"\\n          >\\n            <SlidersHorizontal className=\\\"h-3.5 w-3.5\\\" aria-hidden=\\\"true\\\" />\\n            <span>Household Profile</span>\\n          </button>\\n        </div>\\n      </div>\\n    </header>\\n  );\\n}\\n\", \"Description\":\"Implement TopBar following strict 3-zone Top Bar Contract with single-line navigation links and Household Profile CTA\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TopBar.tsx\", \"toolAction\":\"Writing TopBar component\", \"toolSummary\":\"Write TopBar component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16478336989770057313"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useEffect, useRef, useState } from \'react\';\\nimport { LocateFixed, RefreshCw, Search, X } from \'lucide-react\';\\nimport type { LocationInfo } from \'../types/air\';\\nimport { PRESET_CITIES } from \'../lib/airStyle\';\\n\\ninterface LocationToolbarProps {\\n  location: LocationInfo;\\n  observationTime?: string;\\n  timezone?: string;\\n  isLoading: boolean;\\n  onSelectLocation: (loc: LocationInfo) => void;\\n  onUseGeolocation: () => void;\\n  isLocating: boolean;\\n  geoError: string | null;\\n  onRefresh: () => void;\\n}\\n\\nexport function LocationToolbar({\\n  location,\\n  observationTime,\\n  timezone,\\n  isLoading,\\n  onSelectLocation,\\n  onUseGeolocation,\\n  isLocating,\\n  geoError,\\n  onRefresh,\\n}: LocationToolbarProps) {\\n  const [query, setQuery] = useState(\'\');\\n  const [results, setResults] = useState<LocationInfo[]>([]);\\n  const [isOpen, setIsOpen] = useState(false);\\n  const [searching, setSearching] = useState(false);\\n  const [searchError, setSearchError] = useState<string | null>(null);\\n  const containerRef = useRef<HTMLDivElement>(null);\\n\\n  useEffect(() => {\\n    const handleOutside = (e: MouseEvent) => {\\n      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\\n        setIsOpen(false);\\n      }\\n    };\\n    document.addEventListener(\'mousedown\', handleOutside);\\n    return () => document.removeEventListener(\'mousedown\', handleOutside);\\n  }, []);\\n\\n  useEffect(() => {\\n    const trimmed = query.trim();\\n    if (trimmed.length < 2) {\\n      setResults([]);\\n      setSearchError(null);\\n      return;\\n    }\\n\\n    const controller = new AbortController();\\n    const timer = window.setTimeout(async () => {\\n      setSearching(true);\\n      setSearchError(null);\\n      try {\\n        const res = await fetch(`/api/geocode?q=${encodeURIComponent(trimmed)}`, {\\n          signal: controller.signal,\\n        });\\n        const data = (await res.json()) as { results?: LocationInfo[]; error?: string };\\n        if (!res.ok) {\\n          throw new Error(data.error || \'City lookup failed\');\\n        }\\n        setResults(data.results ?? []);\\n      } catch (err) {\\n        if ((err as Error).name !== \'AbortError\') {\\n          setSearchError(err instanceof Error ? err.message : \'Unable to search cities.\');\\n        }\\n      } finally {\\n        setSearching(false);\\n      }\\n    }, 260);\\n\\n    return () => {\\n      window.clearTimeout(timer);\\n      controller.abort();\\n    };\\n  }, [query]);\\n\\n  const handleChoose = (loc: LocationInfo) => {\\n    onSelectLocation(loc);\\n    setQuery(\'\');\\n    setResults([]);\\n    setIsOpen(false);\\n  };\\n\\n  return (\\n    <section\\n      aria-label=\\\"Location and observation controls\\\"\\n      className=\\\"border-b border-[#E2DDD3] bg-[#FFFFFF]\\\"\\n    >\\n      <div className=\\\"mx-auto max-w-[1240px] px-4 py-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between\\\">\\n          {/* Search & Geolocation Controls */}\\n          <div className=\\\"flex flex-col gap-2 sm:flex-row sm:items-center\\\">\\n            <div ref={containerRef} className=\\\"relative w-full sm:w-80\\\">\\n              <Search\\n                className=\\\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#847F75]\\\"\\n                aria-hidden=\\\"true\\\"\\n              />\\n              <input\\n                type=\\\"text\\\"\\n                value={query}\\n                onFocus={() => setIsOpen(true)}\\n                onChange={(e) => {\\n                  setQuery(e.target.value);\\n                  setIsOpen(true);\\n                }}\\n                placeholder=\\\"Search any city worldwide...\\\"\\n                aria-label=\\\"Search city\\\"\\n                className=\\\"h-10 w-full rounded-md border border-[#D7D1C5] bg-[#F7F5F0] pl-9 pr-8 text-sm text-[#181715] placeholder:text-[#847F75] transition-colors duration-150 focus:border-[#1F4E43] focus:bg-white focus:outline-none\\\"\\n              />\\n              {query && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setQuery(\'\');\\n                    setResults([]);\\n                  }}\\n                  aria-label=\\\"Clear search\\\"\\n                  className=\\\"absolute right-2.5 top-1/2 -translate-y-1/2 text-[#847F75] hover:text-[#181715] cursor-pointer\\\"\\n                >\\n                  <X className=\\\"h-3.5 w-3.5\\\" />\\n                </button>\\n              )}\\n\\n              {isOpen && (\\n                <div className=\\\"absolute left-0 right-0 top-[calc(100%+6px)] z-40 rounded-md border border-[#E2DDD3] bg-white shadow-sm\\\">\\n                  {query.trim().length < 2 ? (\\n                    <div className=\\\"p-2\\\">\\n                      <p className=\\\"px-2.5 py-1.5 text-xs font-medium text-[#847F75]\\\">\\n                        Monitored winter smog corridors\\n                      </p>\\n                      <ul className=\\\"divide-y divide-[#EFECE6]\\\">\\n                        {PRESET_CITIES.map((city) => {\\n                          const active =\\n                            city.name === location.name && city.country === location.country;\\n                          return (\\n                            <li key={`${city.name}-${city.country}`}>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => handleChoose(city)}\\n                                className={`flex w-full items-center justify-between px-2.5 py-2 text-left text-sm transition-colors duration-150 hover:bg-[#F7F5F0] cursor-pointer ${\\n                                  active ? \'font-medium text-[#1F4E43]\' : \'text-[#181715]\'\\n                                }`}\\n                              >\\n                                <span>\\n                                  {city.name}\\n                                  <span className=\\\"text-[#847F75]\\\">, {city.country}</span>\\n                                </span>\\n                                <span className=\\\"font-mono text-xs tabular-nums text-[#847F75]\\\">\\n                                  {city.latitude.toFixed(2)}, {city.longitude.toFixed(2)}\\n                                </span>\\n                              </button>\\n                            </li>\\n                          );\\n                        })}\\n                      </ul>\\n                    </div>\\n                  ) : searching ? (\\n                    <div className=\\\"px-3.5 py-3 text-xs text-[#5E5A52]\\\">\\n                      Searching Open-Meteo stations...\\n                    </div>\\n                  ) : searchError ? (\\n                    <div className=\\\"px-3.5 py-3 text-xs text-[#7F1D1D]\\\">{searchError}</div>\\n                  ) : results.length === 0 ? (\\n                    <div className=\\\"px-3.5 py-3 text-xs text-[#5E5A52]\\\">\\n                      No matching locations found for &ldquo;{query.trim()}&rdquo;.\\n                    </div>\\n                  ) : (\\n                    <ul className=\\\"max-h-64 overflow-y-auto divide-y divide-[#EFECE6] p-1\\\">\\n                      {results.map((item) => (\\n                        <li key={`${item.name}-${item.latitude}-${item.longitude}`}>\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => handleChoose(item)}\\n                            className=\\\"flex w-full items-center justify-between px-3 py-2 text-left text-sm text-[#181715] transition-colors duration-150 hover:bg-[#F7F5F0] cursor-pointer\\\"\\n                          >\\n                            <span className=\\\"truncate pr-3\\\">\\n                              <span className=\\\"font-medium\\\">{item.name}</span>\\n                              <span className=\\\"text-[#5E5A52]\\\">\\n                                {item.admin1 ? `, ${item.admin1}` : \'\'}, {item.country}\\n                              </span>\\n                            </span>\\n                            <span className=\\\"font-mono text-xs tabular-nums text-[#847F75] shrink-0\\\">\\n                              {item.latitude.toFixed(2)}\302\260, {item.longitude.toFixed(2)}\302\260\\n                            </span>\\n                          </button>\\n                        </li>\\n                      ))}\\n                    </ul>\\n                  )}\\n                </div>\\n              )}\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onUseGeolocation}\\n                disabled={isLocating}\\n                className=\\\"inline-flex h-10 items-center gap-2 rounded-md border border-[#D7D1C5] bg-white px-3.5 py-2 text-sm font-medium text-[#181715] whitespace-nowrap shrink-0 transition-colors duration-150 hover:bg-[#F7F5F0] disabled:opacity-60 cursor-pointer\\\"\\n              >\\n                <LocateFixed className=\\\"h-3.5 w-3.5 text-[#1F4E43]\\\" aria-hidden=\\\"true\\\" />\\n                <span>{isLocating ? \'Locating...\' : \'Use my location\'}</span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onRefresh}\\n                disabled={isLoading}\\n                aria-label=\\\"Refresh Open-Meteo data\\\"\\n                className=\\\"inline-flex h-10 items-center gap-1.5 rounded-md border border-[#D7D1C5] bg-white px-3 py-2 text-sm font-medium text-[#5E5A52] whitespace-nowrap shrink-0 transition-colors duration-150 hover:bg-[#F7F5F0] hover:text-[#181715] disabled:opacity-60 cursor-pointer\\\"\\n              >\\n                <RefreshCw\\n                  className={`h-3.5 w-3.5 ${isLoading ? \'animate-spin\' : \'\'}`}\\n                  aria-hidden=\\\"true\\\"\\n                />\\n                <span className=\\\"hidden sm:inline\\\">Refresh</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Unboxed Metadata & Coordinates */}\\n          <div className=\\\"flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-[#5E5A52]\\\">\\n            <span className=\\\"font-medium text-[#181715]\\\">\\n              {location.name}\\n              {location.admin1 ? `, ${location.admin1}` : \'\'}, {location.country}\\n            </span>\\n            <span aria-hidden=\\\"true\\\" className=\\\"text-[#C2BBB0]\\\">\\n              \302\267\\n            </span>\\n            <span className=\\\"font-mono tabular-nums\\\">\\n              {location.latitude.toFixed(2)}\302\260N, {location.longitude.toFixed(2)}\302\260E\\n            </span>\\n            {observationTime && (\\n              <>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-[#C2BBB0]\\\">\\n                  \302\267\\n                </span>\\n                <span className=\\\"font-mono tabular-nums\\\">\\n                  {observationTime.replace(\'T\', \' \')} {timezone ? `(${timezone})` : \'\'}\\n                </span>\\n              </>\\n            )}\\n          </div>\\n        </div>\\n\\n        {geoError && (\\n          <p className=\\\"mt-2.5 text-xs text-[#B84A27]\\\" role=\\\"status\\\">\\n            {geoError}\\n          </p>\\n        )}\\n      </div>\\n    </section>\\n  );\\n}\\n\", \"Description\":\"Create LocationToolbar with Open-Meteo global city search combobox, preset winter smog corridors, geolocation trigger, and unboxed metadata readout\", \"Overwrite\":true, \"TargetFile\":\"/src/components/LocationToolbar.tsx\", \"toolAction\":\"Writing LocationToolbar component\", \"toolSummary\":\"Write LocationToolbar component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16478336989770058538"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { AtmosphericSnapshot, DailyBriefing } from \'../types/air\';\\nimport { getAqiTone, getInversionTone, getPollutantStatusTone } from \'../lib/airStyle\';\\n\\ninterface AirOverviewHeroProps {\\n  snapshot: AtmosphericSnapshot;\\n  briefing: DailyBriefing | null;\\n  briefingLoading: boolean;\\n}\\n\\nexport function AirOverviewHero({\\n  snapshot,\\n  briefing,\\n  briefingLoading,\\n}: AirOverviewHeroProps) {\\n  const { current, inversion, bestVentilationWindow, pollutants } = snapshot;\\n  const aqiTone = getAqiTone(current.band);\\n  const inversionTone = getInversionTone(inversion.risk);\\n\\n  const showAlert = current.usAqi >= 101 || inversion.risk === \'high\' || briefing?.alert.active;\\n\\n  return (\\n    <section id=\\\"overview\\\" className=\\\"scroll-mt-20 space-y-6\\\">\\n      {/* Real-Time Smog & Inversion Alert Notice (flat hairline surface, no border-l-4) */}\\n      {showAlert && (\\n        <div\\n          role=\\\"region\\\"\\n          aria-label=\\\"Active air quality advisory\\\"\\n          className={`rounded-md border px-5 py-4 ${aqiTone.surfaceTint} ${aqiTone.borderTint}`}\\n        >\\n          <div className=\\\"flex flex-col gap-3 md:flex-row md:items-start md:justify-between\\\">\\n            <div className=\\\"space-y-1.5\\\">\\n              <div className=\\\"flex flex-wrap items-center gap-2 text-xs font-medium\\\">\\n                <span className={aqiTone.textClass}>\\n                  {aqiTone.glyph} {briefing?.alert.severityLabel || current.bandLabel} Advisory\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-[#B8B1A5]\\\">\\n                  \302\267\\n                </span>\\n                <span className=\\\"text-[#5E5A52]\\\">\\n                  Primary driver: {current.dominantPollutant} ({current.pm25} \302\265g/m\302\263 PM2.5)\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-[#B8B1A5]\\\">\\n                  \302\267\\n                </span>\\n                <span className={inversionTone.textClass}>\\n                  {inversionTone.glyph} {inversion.label}\\n                </span>\\n              </div>\\n              <p className=\\\"text-sm font-medium text-[#181715] max-w-3xl\\\">\\n                {briefing?.alert.headline || current.advisorySummary}\\n              </p>\\n              {briefing?.alert.immediateActions && briefing.alert.immediateActions.length > 0 && (\\n                <ul className=\\\"flex flex-wrap gap-x-6 gap-y-1 pt-1 text-xs text-[#5E5A52]\\\">\\n                  {briefing.alert.immediateActions.map((act, i) => (\\n                    <li key={i} className=\\\"flex items-baseline gap-1.5\\\">\\n                      <span className=\\\"font-mono text-[11px] text-[#847F75]\\\">0{i + 1}.</span>\\n                      <span>{act}</span>\\n                    </li>\\n                  ))}\\n                </ul>\\n              )}\\n            </div>\\n\\n            <div className=\\\"shrink-0 text-left md:text-right\\\">\\n              <p className=\\\"text-xs text-[#5E5A52]\\\">Best ventilation slot today</p>\\n              <p className=\\\"font-mono text-sm font-semibold tabular-nums text-[#181715]\\\">\\n                {bestVentilationWindow.windowLabel}\\n              </p>\\n              <p className=\\\"text-xs text-[#5E5A52]\\\">\\n                {bestVentilationWindow.advisable\\n                  ? `Brief airing (avg AQI ${bestVentilationWindow.avgAqi})`\\n                  : `Keep sealed (avg AQI ${bestVentilationWindow.avgAqi})`}\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Primary Asymmetric Instrument Grid */}\\n      <div className=\\\"grid grid-cols-1 gap-6 lg:grid-cols-12 items-stretch\\\">\\n        {/* Left Dominant Focal Anchor: Live AQI & Atmospheric State */}\\n        <div className=\\\"lg:col-span-7 flex flex-col justify-between rounded-md border border-[#E2DDD3] bg-white p-6 sm:p-7\\\">\\n          <div>\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2 border-b border-[#EFECE6] pb-4\\\">\\n              <div>\\n                <p className=\\\"text-xs font-medium text-[#5E5A52]\\\">\\n                  Live Open-Meteo Atmospheric Reading\\n                </p>\\n                <h1 className=\\\"mt-0.5 text-2xl font-semibold tracking-tight text-[#181715] [text-wrap:balance]\\\">\\n                  {snapshot.location.name} Air &amp; Dispersion Report\\n                </h1>\\n              </div>\\n              <div className={`text-sm font-semibold ${aqiTone.textClass}`}>\\n                {aqiTone.glyph} {current.bandLabel}\\n              </div>\\n            </div>\\n\\n            <div className=\\\"mt-6 grid grid-cols-1 gap-6 sm:grid-cols-12 sm:items-end\\\">\\n              <div className=\\\"sm:col-span-5\\\">\\n                <p className=\\\"text-xs text-[#5E5A52]\\\">US Air Quality Index</p>\\n                <div className=\\\"mt-1 flex items-baseline gap-2.5\\\">\\n                  <span className=\\\"font-mono text-5xl font-semibold tracking-tight tabular-nums text-[#181715] sm:text-6xl\\\">\\n                    {current.usAqi}\\n                  </span>\\n                  <span className=\\\"font-mono text-xs text-[#847F75]\\\">US AQI</span>\\n                </div>\\n                <p className=\\\"mt-2 text-xs text-[#5E5A52]\\\">\\n                  EU AQI <span className=\\\"font-mono tabular-nums text-[#181715]\\\">{current.europeanAqi}</span>\\n                  <span aria-hidden=\\\"true\\\" className=\\\"mx-1.5 text-[#C2BBB0]\\\">\\n                    \302\267\\n                  </span>\\n                  PM2.5 is{\' \'}\\n                  <span className={`font-mono font-medium tabular-nums ${aqiTone.textClass}`}>\\n                    {current.whoPm25Multiple}\303\227\\n                  </span>{\' \'}\\n                  WHO 24h limit\\n                </p>\\n              </div>\\n\\n              <div className=\\\"sm:col-span-7 border-t border-[#EFECE6] pt-4 sm:border-t-0 sm:border-l sm:pl-6 sm:pt-0\\\">\\n                <p className=\\\"text-xs font-medium text-[#5E5A52]\\\">Today&apos;s Briefing Summary</p>\\n                {briefingLoading && !briefing ? (\\n                  <div className=\\\"mt-2 space-y-2\\\" aria-label=\\\"Loading tailored summary\\\">\\n                    <div className=\\\"h-3.5 w-full rounded bg-[#EFECE6]\\\" />\\n                    <div className=\\\"h-3.5 w-11/12 rounded bg-[#EFECE6]\\\" />\\n                    <div className=\\\"h-3.5 w-3/4 rounded bg-[#EFECE6]\\\" />\\n                  </div>\\n                ) : (\\n                  <p className=\\\"mt-1.5 text-sm leading-relaxed text-[#181715]\\\">\\n                    {briefing?.headlineSummary || current.advisorySummary}\\n                  </p>\\n                )}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* 4-Column Meteorological Dispersion Strip */}\\n          <div className=\\\"mt-7 grid grid-cols-2 gap-4 border-t border-[#EFECE6] pt-5 sm:grid-cols-4\\\">\\n            <div>\\n              <p className=\\\"text-xs text-[#5E5A52]\\\">Temperature</p>\\n              <p className=\\\"mt-1 font-mono text-lg font-medium tabular-nums text-[#181715]\\\">\\n                {current.temperature}\\n                <span className=\\\"ml-1 text-xs font-normal text-[#847F75]\\\">\302\260C</span>\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#5E5A52]\\\">Wind Dispersion</p>\\n              <p className=\\\"mt-1 font-mono text-lg font-medium tabular-nums text-[#181715]\\\">\\n                {current.windSpeed}\\n                <span className=\\\"ml-1 text-xs font-normal text-[#847F75]\\\">km/h</span>\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#5E5A52]\\\">Relative Humidity</p>\\n              <p className=\\\"mt-1 font-mono text-lg font-medium tabular-nums text-[#181715]\\\">\\n                {current.humidity}\\n                <span className=\\\"ml-1 text-xs font-normal text-[#847F75]\\\">%</span>\\n              </p>\\n            </div>\\n            <div>\\n              <p className=\\\"text-xs text-[#5E5A52]\\\">Visibility</p>\\n              <p className=\\\"mt-1 font-mono text-lg font-medium tabular-nums text-[#181715]\\\">\\n                {current.visibilityKm}\\n                <span className=\\\"ml-1 text-xs font-normal text-[#847F75]\\\">km</span>\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Right Structural Panel: 6-Pollutant Specification Table & Inversion Analysis */}\\n        <div className=\\\"lg:col-span-5 flex flex-col justify-between rounded-md border border-[#E2DDD3] bg-white p-6\\\">\\n          <div>\\n            <div className=\\\"flex items-baseline justify-between border-b border-[#EFECE6] pb-3.5\\\">\\n              <h2 className=\\\"text-base font-semibold text-[#181715]\\\">Pollutant Composition</h2>\\n              <span className=\\\"text-xs text-[#847F75]\\\">WHO 2021 reference</span>\\n            </div>\\n\\n            <div className=\\\"mt-2 overflow-x-auto\\\">\\n              <table className=\\\"w-full border-collapse text-left text-sm\\\">\\n                <thead>\\n                  <tr className=\\\"border-b border-[#EFECE6] text-xs font-medium text-[#847F75]\\\">\\n                    <th className=\\\"py-2 pr-3 font-medium\\\">Pollutant</th>\\n                    <th className=\\\"py-2 px-2 text-right font-medium\\\">Current</th>\\n                    <th className=\\\"py-2 px-2 text-right font-medium\\\">WHO Limit</th>\\n                    <th className=\\\"py-2 pl-2 text-right font-medium\\\">Status</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-[#EFECE6]\\\">\\n                  {pollutants.map((item) => {\\n                    const tone = getPollutantStatusTone(item.status);\\n                    return (\\n                      <tr key={item.key} className=\\\"hover:bg-[#FAF9F6] transition-colors duration-100\\\">\\n                        <td className=\\\"py-2.5 pr-3\\\">\\n                          <span className=\\\"font-mono text-xs font-semibold text-[#181715]\\\">\\n                            {item.formula}\\n                          </span>\\n                          <span className=\\\"ml-2 text-xs text-[#5E5A52]\\\">{item.label}</span>\\n                        </td>\\n                        <td className=\\\"py-2.5 px-2 text-right font-mono text-xs font-medium tabular-nums text-[#181715] whitespace-nowrap\\\">\\n                          {item.value}{\' \'}\\n                          <span className=\\\"text-[11px] font-normal text-[#847F75]\\\">\\n                            {item.unit}\\n                          </span>\\n                        </td>\\n                        <td className=\\\"py-2.5 px-2 text-right font-mono text-xs tabular-nums text-[#847F75] whitespace-nowrap\\\">\\n                          {item.whoLimit}\\n                        </td>\\n                        <td\\n                          className={`py-2.5 pl-2 text-right text-xs font-medium whitespace-nowrap ${tone.textClass}`}\\n                        >\\n                          {tone.label}\\n                        </td>\\n                      </tr>\\n                    );\\n                  })}\\n                </tbody>\\n              </table>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"mt-5 border-t border-[#EFECE6] pt-4\\\">\\n            <div className=\\\"flex items-center justify-between gap-2\\\">\\n              <p className=\\\"text-xs font-medium text-[#5E5A52]\\\">Boundary-Layer Dispersion</p>\\n              <span className={`text-xs font-semibold ${inversionTone.textClass}`}>\\n                {inversionTone.glyph} {inversion.label}\\n              </span>\\n            </div>\\n            <p className=\\\"mt-1.5 text-xs leading-relaxed text-[#5E5A52]\\\">\\n              {briefing?.inversionExplanation || inversion.summary}\\n            </p>\\n          </div>\\n        </div>\\n      </div>\\n    </section>\\n  );\\n}\\n\", \"Description\":\"Implement AirOverviewHero with active smog advisory notice, US AQI & WHO focal anchor, dispersion strip, and 6-pollutant WHO specification table\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AirOverviewHero.tsx\", \"toolAction\":\"Writing AirOverviewHero component\", \"toolSummary\":\"Write AirOverviewHero component\"}"
      original_name: "write_to_file"
