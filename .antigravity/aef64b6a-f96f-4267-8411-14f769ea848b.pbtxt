              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Diminishing-returns combined exposure drop so percentage remains scientifically honest (capped <= 68%)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const remainingExposureFactor = committed.reduce("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
