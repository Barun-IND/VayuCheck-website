    tool_calls {
      id: "call_8716728884633094279"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add parallel /api/briefing/summary and /api/briefing/actions Express endpoints in server.ts\", \"EndLine\":126, \"Instruction\":\"Import generateBriefingSummary and generateBriefingActions and expose /api/briefing/summary and /api/briefing/actions routes alongside /api/briefing\", \"ReplacementContent\":\"import {\\n  generateBriefingActions,\\n  generateBriefingSummary,\\n  generateDailyBriefing,\\n} from \'./server/geminiBriefing.ts\';\\nimport type { AtmosphericSnapshot, HouseholdProfile, LocationInfo } from \'./src/types/air.ts\';\\n\\nconst __filename = fileURLToPath(import.meta.url);\\nconst __dirname = path.dirname(__filename);\\n\\nfunction formatGeminiError(err: unknown): { status: number; error: string } {\\n  const rawMessage = err instanceof Error ? err.message : \'Failed to generate daily briefing.\';\\n  if (rawMessage.includes(\'API_KEY_INVALID\') || rawMessage.includes(\'PERMISSION_DENIED\')) {\\n    return {\\n      status: 403,\\n      error: \'Gemini API key error. Please verify your API key in Settings > Secrets.\',\\n    };\\n  }\\n  if (rawMessage.includes(\'RESOURCE_EXHAUSTED\') || rawMessage.includes(\'429\')) {\\n    return {\\n      status: 429,\\n      error:\\n        \'Gemini API rate limit reached. Please retry in a few seconds or check your API key quota in Settings > Secrets.\',\\n    };\\n  }\\n  if (rawMessage.includes(\'GEMINI_API_KEY is not configured\')) {\\n    return { status: 503, error: rawMessage };\\n  }\\n  return { status: 500, error: rawMessage };\\n}\\n\\nasync function startServer() {\\n  const app = express();\\n  const PORT = Number(process.env.PORT) || 3000;\\n\\n  app.use(express.json({ limit: \'1mb\' }));\\n\\n  app.get(\'/api/health\', (_req, res) => {\\n    res.json({ status: \'ok\' });\\n  });\\n\\n  app.get(\'/api/geocode\', async (req, res) => {\\n    try {\\n      const q = typeof req.query.q === \'string\' ? req.query.q : \'\';\\n      const results = await searchCities(q);\\n      res.json({ results });\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : \'Unable to search locations.\';\\n      res.status(502).json({ error: message });\\n    }\\n  });\\n\\n  app.get(\'/api/reverse-geocode\', async (req, res) => {\\n    try {\\n      const latStr = typeof req.query.lat === \'string\' ? req.query.lat.trim() : \'\';\\n      const lonStr = typeof req.query.lon === \'string\' ? req.query.lon.trim() : \'\';\\n      const lat = Number(latStr);\\n      const lon = Number(lonStr);\\n      if (!latStr || !lonStr || !Number.isFinite(lat) || !Number.isFinite(lon)) {\\n        res.status(400).json({ error: \'Valid numeric lat and lon query parameters are required.\' });\\n        return;\\n      }\\n      const location = await reverseGeocode(lat, lon);\\n      res.json({ location });\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : \'Unable to resolve coordinates.\';\\n      res.status(502).json({ error: message });\\n    }\\n  });\\n\\n  app.get(\'/api/air-data\', async (req, res) => {\\n    try {\\n      const latStr = typeof req.query.lat === \'string\' ? req.query.lat.trim() : \'\';\\n      const lonStr = typeof req.query.lon === \'string\' ? req.query.lon.trim() : \'\';\\n      const latRaw = Number(latStr);\\n      const lonRaw = Number(lonStr);\\n      const hasCoords =\\n        latStr.length > 0 &&\\n        lonStr.length > 0 &&\\n        Number.isFinite(latRaw) &&\\n        Number.isFinite(lonRaw);\\n\\n      const location: LocationInfo = hasCoords\\n        ? {\\n            name:\\n              typeof req.query.name === \'string\' && req.query.name.trim()\\n                ? req.query.name.trim()\\n                : `${latRaw.toFixed(2)}, ${lonRaw.toFixed(2)}`,\\n            admin1:\\n              typeof req.query.admin1 === \'string\' && req.query.admin1.trim()\\n                ? req.query.admin1.trim()\\n                : undefined,\\n            country:\\n              typeof req.query.country === \'string\' && req.query.country.trim()\\n                ? req.query.country.trim()\\n                : \'Local Coordinates\',\\n            latitude: latRaw,\\n            longitude: lonRaw,\\n          }\\n        : DEFAULT_LOCATION;\\n\\n      const bypassCache = req.query.refresh === \'1\';\\n      const snapshot = await fetchAtmosphericData(location, bypassCache);\\n      res.json(snapshot);\\n    } catch (err) {\\n      const message =\\n        err instanceof Error ? err.message : \'Unable to fetch Open-Meteo air quality data.\';\\n      res.status(502).json({ error: message });\\n    }\\n  });\\n\\n  app.post(\'/api/briefing/summary\', async (req, res) => {\\n    try {\\n      const { snapshot, profile, forceRefresh } = req.body as {\\n        snapshot?: AtmosphericSnapshot;\\n        profile?: HouseholdProfile;\\n        forceRefresh?: boolean;\\n      };\\n      if (!snapshot || !snapshot.current || !profile) {\\n        res.status(400).json({ error: \'Both atmospheric snapshot and household profile are required.\' });\\n        return;\\n      }\\n      const summary = await generateBriefingSummary(snapshot, profile, Boolean(forceRefresh));\\n      res.json(summary);\\n    } catch (err) {\\n      const { status, error } = formatGeminiError(err);\\n      res.status(status).json({ error });\\n    }\\n  });\\n\\n  app.post(\'/api/briefing/actions\', async (req, res) => {\\n    try {\\n      const { snapshot, profile, forceRefresh } = req.body as {\\n        snapshot?: AtmosphericSnapshot;\\n        profile?: HouseholdProfile;\\n        forceRefresh?: boolean;\\n      };\\n      if (!snapshot || !snapshot.current || !profile) {\\n        res.status(400).json({ error: \'Both atmospheric snapshot and household profile are required.\' });\\n        return;\\n      }\\n      const actions = await generateBriefingActions(snapshot, profile, Boolean(forceRefresh));\\n      res.json(actions);\\n    } catch (err) {\\n      const { status, error } = formatGeminiError(err);\\n      res.status(status).json({ error });\\n    }\\n  });\\n\\n  app.post(\'/api/briefing\', async (req, res) => {\\n    try {\\n      const { snapshot, profile, forceRefresh } = req.body as {\\n        snapshot?: AtmosphericSnapshot;\\n        profile?: HouseholdProfile;\\n        forceRefresh?: boolean;\\n      };\\n\\n      if (!snapshot || !snapshot.current || !profile) {\\n        res.status(400).json({ error: \'Both atmospheric snapshot and household profile are required.\' });\\n        return;\\n      }\\n\\n      const briefing = await generateDailyBriefing(snapshot, profile, Boolean(forceRefresh));\\n      res.json(briefing);\\n    } catch (err) {\\n      const { status, error } = formatGeminiError(err);\\n      res.status(status).json({ error });\\n    }\\n  });\", \"StartLine\":11, \"TargetContent\":\"import { generateDailyBriefing } from \'./server/geminiBriefing.ts\';\\nimport type { AtmosphericSnapshot, HouseholdProfile, LocationInfo } from \'./src/types/air.ts\';\\n\\nconst __filename = fileURLToPath(import.meta.url);\\nconst __dirname = path.dirname(__filename);\\n\\nasync function startServer() {\\n  const app = express();\\n  const PORT = Number(process.env.PORT) || 3000;\\n\\n  app.use(express.json({ limit: \'1mb\' }));\\n\\n  app.get(\'/api/health\', (_req, res) => {\\n    res.json({ status: \'ok\' });\\n  });\\n\\n  app.get(\'/api/geocode\', async (req, res) => {\\n    try {\\n      const q = typeof req.query.q === \'string\' ? req.query.q : \'\';\\n      const results = await searchCities(q);\\n      res.json({ results });\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : \'Unable to search locations.\';\\n      res.status(502).json({ error: message });\\n    }\\n  });\\n\\n  app.get(\'/api/reverse-geocode\', async (req, res) => {\\n    try {\\n      const latStr = typeof req.query.lat === \'string\' ? req.query.lat.trim() : \'\';\\n      const lonStr = typeof req.query.lon === \'string\' ? req.query.lon.trim() : \'\';\\n      const lat = Number(latStr);\\n      const lon = Number(lonStr);\\n      if (!latStr || !lonStr || !Number.isFinite(lat) || !Number.isFinite(lon)) {\\n        res.status(400).json({ error: \'Valid numeric lat and lon query parameters are required.\' });\\n        return;\\n      }\\n      const location = await reverseGeocode(lat, lon);\\n      res.json({ location });\\n    } catch (err) {\\n      const message = err instanceof Error ? err.message : \'Unable to resolve coordinates.\';\\n      res.status(502).json({ error: message });\\n    }\\n  });\\n\\n  app.get(\'/api/air-data\', async (req, res) => {\\n    try {\\n      const latStr = typeof req.query.lat === \'string\' ? req.query.lat.trim() : \'\';\\n      const lonStr = typeof req.query.lon === \'string\' ? req.query.lon.trim() : \'\';\\n      const latRaw = Number(latStr);\\n      const lonRaw = Number(lonStr);\\n      const hasCoords =\\n        latStr.length > 0 &&\\n        lonStr.length > 0 &&\\n        Number.isFinite(latRaw) &&\\n        Number.isFinite(lonRaw);\\n\\n      const location: LocationInfo = hasCoords\\n        ? {\\n            name:\\n              typeof req.query.name === \'string\' && req.query.name.trim()\\n                ? req.query.name.trim()\\n                : `${latRaw.toFixed(2)}, ${lonRaw.toFixed(2)}`,\\n            admin1:\\n              typeof req.query.admin1 === \'string\' && req.query.admin1.trim()\\n                ? req.query.admin1.trim()\\n                : undefined,\\n            country:\\n              typeof req.query.country === \'string\' && req.query.country.trim()\\n                ? req.query.country.trim()\\n                : \'Local Coordinates\',\\n            latitude: latRaw,\\n            longitude: lonRaw,\\n          }\\n        : DEFAULT_LOCATION;\\n\\n      const bypassCache = req.query.refresh === \'1\';\\n      const snapshot = await fetchAtmosphericData(location, bypassCache);\\n      res.json(snapshot);\\n    } catch (err) {\\n      const message =\\n        err instanceof Error ? err.message : \'Unable to fetch Open-Meteo air quality data.\';\\n      res.status(502).json({ error: message });\\n    }\\n  });\\n\\n  app.post(\'/api/briefing\', async (req, res) => {\\n    try {\\n      const { snapshot, profile, forceRefresh } = req.body as {\\n        snapshot?: AtmosphericSnapshot;\\n        profile?: HouseholdProfile;\\n        forceRefresh?: boolean;\\n      };\\n\\n      if (!snapshot || !snapshot.current || !profile) {\\n        res.status(400).json({ error: \'Both atmospheric snapshot and household profile are required.\' });\\n        return;\\n      }\\n\\n      const briefing = await generateDailyBriefing(snapshot, profile, Boolean(forceRefresh));\\n      res.json(briefing);\\n    } catch (err) {\\n      const rawMessage = err instanceof Error ? err.message : \'Failed to generate daily briefing.\';\\n      let status = 500;\\n      let userMessage = rawMessage;\\n\\n      if (rawMessage.includes(\'API_KEY_INVALID\') || rawMessage.includes(\'PERMISSION_DENIED\')) {\\n        status = 403;\\n        userMessage =\\n          \'Gemini API key error. Please verify your API key in Settings > Secrets.\';\\n      } else if (rawMessage.includes(\'RESOURCE_EXHAUSTED\') || rawMessage.includes(\'429\')) {\\n        status = 429;\\n        userMessage =\\n          \'Gemini API rate limit reached. Please retry in a few seconds or check your API key quota in Settings > Secrets.\';\\n      } else if (rawMessage.includes(\'GEMINI_API_KEY is not configured\')) {\\n        status = 503;\\n        userMessage = rawMessage;\\n      }\\n\\n      res.status(status).json({ error: userMessage });\\n    }\\n  });\", \"TargetFile\":\"/server.ts\", \"toolAction\":\"Adding parallel briefing routes to server.ts\", \"toolSummary\":\"Add parallel briefing routes\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_8716728884633094632"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add Enter-key city selection to LocationToolbar search input so typing a city name and hitting Enter switches immediately\", \"EndLine\":112, \"Instruction\":\"Add handleSearchKeyDown to select the top matching city on Enter (fetching immediately if still debouncing) and wire onKeyDown on the search input\", \"ReplacementContent\":\"  const handleChoose = (loc: LocationInfo) => {\\n    onSelectLocation(loc);\\n    setQuery(\'\');\\n    setResults([]);\\n    setIsOpen(false);\\n  };\\n\\n  const handleSearchKeyDown = async (e: React.KeyboardEvent<HTMLInputElement>) => {\\n    if (e.key === \'Escape\') {\\n      setIsOpen(false);\\n      return;\\n    }\\n    if (e.key !== \'Enter\') return;\\n    e.preventDefault();\\n    if (results.length > 0) {\\n      handleChoose(results[0]);\\n      return;\\n    }\\n    const trimmed = query.trim();\\n    if (trimmed.length < 2) return;\\n    setSearching(true);\\n    setSearchError(null);\\n    try {\\n      const res = await fetch(`/api/geocode?q=${encodeURIComponent(trimmed)}`);\\n      const data = (await res.json()) as { results?: LocationInfo[]; error?: string };\\n      if (res.ok && data.results && data.results.length > 0) {\\n        handleChoose(data.results[0]);\\n      } else {\\n        setResults([]);\\n      }\\n    } catch (err) {\\n      setSearchError(err instanceof Error ? err.message : \'Unable to search cities.\');\\n    } finally {\\n      setSearching(false);\\n    }\\n  };\\n\\n  return (\\n    <section\\n      aria-label=\\\"Location and observation controls\\\"\\n      className=\\\"border-b border-[#E2DDD3] bg-[#FFFFFF]\\\"\\n    >\\n      <div className=\\\"mx-auto max-w-[1240px] px-4 py-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between\\\">\\n          {/* Search & Geolocation Controls */}\\n          <div className=\\\"flex flex-col gap-2 sm:flex-row sm:items-center\\\">\\n            <div ref={containerRef} className=\\\"relative w-full sm:w-80\\\">\\n              <Search\\n                className=\\\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#847F75]\\\"\\n                aria-hidden=\\\"true\\\"\\n              />\\n              <input\\n                type=\\\"text\\\"\\n                value={query}\\n                onFocus={() => setIsOpen(true)}\\n                onKeyDown={(e) => void handleSearchKeyDown(e)}\\n                onChange={(e) => {\\n                  setQuery(e.target.value);\\n                  setIsOpen(true);\\n                }}\\n                placeholder=\\\"Search any city worldwide...\\\"\", \"StartLine\":74, \"TargetContent\":\"  const handleChoose = (loc: LocationInfo) => {\\n    onSelectLocation(loc);\\n    setQuery(\'\');\\n    setResults([]);\\n    setIsOpen(false);\\n  };\\n\\n  return (\\n    <section\\n      aria-label=\\\"Location and observation controls\\\"\\n      className=\\\"border-b border-[#E2DDD3] bg-[#FFFFFF]\\\"\\n    >\\n      <div className=\\\"mx-auto max-w-[1240px] px-4 py-4 sm:px-6 lg:px-8\\\">\\n        <div className=\\\"flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between\\\">\\n          {/* Search & Geolocation Controls */}\\n          <div className=\\\"flex flex-col gap-2 sm:flex-row sm:items-center\\\">\\n            <div ref={containerRef} className=\\\"relative w-full sm:w-80\\\">\\n              <Search\\n                className=\\\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#847F75]\\\"\\n                aria-hidden=\\\"true\\\"\\n              />\\n              <input\\n                type=\\\"text\\\"\\n                value={query}\\n                onFocus={() => setIsOpen(true)}\\n                onChange={(e) => {\\n                  setQuery(e.target.value);\\n                  setIsOpen(true);\\n                }}\\n                placeholder=\\\"Search any city worldwide...\\\"\", \"TargetFile\":\"/src/components/LocationToolbar.tsx\", \"toolAction\":\"Adding Enter-key city search selection\", \"toolSummary\":\"Add Enter-key search selection\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_8716728884633094985"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useRef, useState } from \'react\';\\nimport type {\\n  AtmosphericSnapshot,\\n  BriefingRecommendation,\\n  DailyBriefing,\\n  HouseholdProfile,\\n  LocationInfo,\\n} from \'./types/air\';\\nimport { DEFAULT_CITY, DEFAULT_PROFILE } from \'./lib/airStyle\';\\nimport { TopBar } from \'./components/TopBar\';\\nimport { LocationToolbar } from \'./components/LocationToolbar\';\\nimport { AirOverviewHero } from \'./components/AirOverviewHero\';\\nimport { ForecastChart } from \'./components/ForecastChart\';\\nimport { ActivityPlanner } from \'./components/ActivityPlanner\';\\nimport { DailyBriefingLedger } from \'./components/DailyBriefingLedger\';\\nimport { ProfileDrawer } from \'./components/ProfileDrawer\';\\n\\nconst STORAGE_LOCATION_KEY = \'air_almanac_location_v1\';\\nconst STORAGE_PROFILE_KEY = \'air_almanac_profile_v1\';\\nconst STORAGE_COMMIT_KEY = \'air_almanac_commits_v1\';\\n\\ntype BriefingSummaryResponse = Pick<\\n  DailyBriefing,\\n  \'generatedAt\' | \'headlineSummary\' | \'inversionExplanation\' | \'alert\' | \'activityNotes\'\\n>;\\n\\ninterface BriefingActionsResponse {\\n  generatedAt: string;\\n  recommendations: BriefingRecommendation[];\\n}\\n\\nfunction getTodayKey(): string {\\n  return new Date().toISOString().slice(0, 10);\\n}\\n\\nfunction loadStoredLocation(): LocationInfo {\\n  try {\\n    const raw = localStorage.getItem(STORAGE_LOCATION_KEY);\\n    if (!raw) return DEFAULT_CITY;\\n    const parsed = JSON.parse(raw) as LocationInfo;\\n    if (typeof parsed.latitude === \'number\' && typeof parsed.longitude === \'number\') {\\n      return parsed;\\n    }\\n  } catch {\\n    // ignore storage errors\\n  }\\n  return DEFAULT_CITY;\\n}\\n\\nfunction loadStoredProfile(): HouseholdProfile {\\n  try {\\n    const raw = localStorage.getItem(STORAGE_PROFILE_KEY);\\n    if (!raw) return DEFAULT_PROFILE;\\n    const parsed = JSON.parse(raw) as Partial<HouseholdProfile>;\\n    return {\\n      sensitivity: parsed.sensitivity ?? DEFAULT_PROFILE.sensitivity,\\n      commute: parsed.commute ?? DEFAULT_PROFILE.commute,\\n      heatingCooking: parsed.heatingCooking ?? DEFAULT_PROFILE.heatingCooking,\\n      indoorSetup: parsed.indoorSetup ?? DEFAULT_PROFILE.indoorSetup,\\n      householdSize:\\n        typeof parsed.householdSize === \'number\' && parsed.householdSize >= 1\\n          ? parsed.householdSize\\n          : DEFAULT_PROFILE.householdSize,\\n    };\\n  } catch {\\n    return DEFAULT_PROFILE;\\n  }\\n}\\n\\nfunction loadStoredCommits(): string[] {\\n  try {\\n    const raw = localStorage.getItem(STORAGE_COMMIT_KEY);\\n    if (!raw) return [];\\n    const parsed = JSON.parse(raw) as { date?: string; ids?: string[] };\\n    if (parsed.date === getTodayKey() && Array.isArray(parsed.ids)) {\\n      return parsed.ids;\\n    }\\n  } catch {\\n    // ignore storage errors\\n  }\\n  return [];\\n}\\n\\nexport default function App() {\\n  const [location, setLocation] = useState<LocationInfo>(loadStoredLocation);\\n  const [profile, setProfile] = useState<HouseholdProfile>(loadStoredProfile);\\n  const [committedIds, setCommittedIds] = useState<string[]>(loadStoredCommits);\\n\\n  const [snapshot, setSnapshot] = useState<AtmosphericSnapshot | null>(null);\\n  const [airLoading, setAirLoading] = useState<boolean>(true);\\n  const [airError, setAirError] = useState<string | null>(null);\\n\\n  const [summaryData, setSummaryData] = useState<BriefingSummaryResponse | null>(null);\\n  const [summaryLoading, setSummaryLoading] = useState<boolean>(false);\\n\\n  const [recommendations, setRecommendations] = useState<BriefingRecommendation[]>([]);\\n  const [actionsLoading, setActionsLoading] = useState<boolean>(false);\\n  const [actionsError, setActionsError] = useState<string | null>(null);\\n\\n  const [profileOpen, setProfileOpen] = useState<boolean>(false);\\n  const [isLocating, setIsLocating] = useState<boolean>(false);\\n  const [geoError, setGeoError] = useState<string | null>(null);\\n\\n  const airAbortRef = useRef<AbortController | null>(null);\\n  const airSeqRef = useRef<number>(0);\\n  const summaryAbortRef = useRef<AbortController | null>(null);\\n  const summarySeqRef = useRef<number>(0);\\n  const actionsAbortRef = useRef<AbortController | null>(null);\\n  const actionsSeqRef = useRef<number>(0);\\n\\n  // If a prior session stored a raw \\\"Current Location\\\" coordinate label, upgrade it via reverse-geocode once\\n  useEffect(() => {\\n    if (location.name !== \'Current Location\') return;\\n    let cancelled = false;\\n    fetch(\\n      `/api/reverse-geocode?lat=${encodeURIComponent(\\n        String(location.latitude)\\n      )}&lon=${encodeURIComponent(String(location.longitude))}`\\n    )\\n      .then((res) => (res.ok ? res.json() : null))\\n      .then((payload: { location?: LocationInfo } | null) => {\\n        if (cancelled || !payload?.location || payload.location.name === \'Current Location\') return;\\n        setLocation(payload.location);\\n        try {\\n          localStorage.setItem(STORAGE_LOCATION_KEY, JSON.stringify(payload.location));\\n        } catch {\\n          // ignore\\n        }\\n      })\\n      .catch(() => {\\n        // ignore\\n      });\\n    return () => {\\n      cancelled = true;\\n    };\\n  }, [location.name, location.latitude, location.longitude]);\\n\\n  const fetchAir = useCallback(async (loc: LocationInfo, forceRefresh = false) => {\\n    airAbortRef.current?.abort();\\n    summaryAbortRef.current?.abort();\\n    actionsAbortRef.current?.abort();\\n\\n    const controller = new AbortController();\\n    airAbortRef.current = controller;\\n    const reqId = ++airSeqRef.current;\\n\\n    setAirLoading(true);\\n    setAirError(null);\\n    setSummaryData(null);\\n    setRecommendations([]);\\n    setActionsError(null);\\n    setSummaryLoading(false);\\n    setActionsLoading(false);\\n\\n    try {\\n      const params = new URLSearchParams({\\n        lat: String(loc.latitude),\\n        lon: String(loc.longitude),\\n        name: loc.name,\\n        country: loc.country,\\n      });\\n      if (loc.admin1) params.set(\'admin1\', loc.admin1);\\n      if (forceRefresh) params.set(\'refresh\', \'1\');\\n\\n      const res = await fetch(`/api/air-data?${params.toString()}`, {\\n        signal: controller.signal,\\n      });\\n      const data = (await res.json()) as AtmosphericSnapshot & { error?: string };\\n      if (!res.ok) {\\n        throw new Error(data.error || `Air data request failed (${res.status})`);\\n      }\\n\\n      if (reqId !== airSeqRef.current) return;\\n      setSnapshot(data);\\n    } catch (err) {\\n      if ((err as Error).name === \'AbortError\' || reqId !== airSeqRef.current) {\\n        return;\\n      }\\n      setAirError(\\n        err instanceof Error\\n          ? err.message\\n          : \'Unable to load Open-Meteo atmospheric observations.\'\\n      );\\n    } finally {\\n      if (reqId === airSeqRef.current) {\\n        setAirLoading(false);\\n      }\\n    }\\n  }, []);\\n\\n  const fetchSummaryAndActions = useCallback(\\n    (snap: AtmosphericSnapshot, prof: HouseholdProfile, forceRefresh = false) => {\\n      // 1) Fast parallel call for Today\'s Briefing Summary, Alert & Activity Notes\\n      summaryAbortRef.current?.abort();\\n      const sController = new AbortController();\\n      summaryAbortRef.current = sController;\\n      const sReqId = ++summarySeqRef.current;\\n      setSummaryLoading(true);\\n\\n      fetch(\'/api/briefing/summary\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ snapshot: snap, profile: prof, forceRefresh }),\\n        signal: sController.signal,\\n      })\\n        .then(async (res) => {\\n          const data = (await res.json()) as BriefingSummaryResponse & { error?: string };\\n          if (!res.ok) throw new Error(data.error || `Summary request failed (${res.status})`);\\n          if (sReqId !== summarySeqRef.current) return;\\n          setSummaryData(data);\\n        })\\n        .catch((err) => {\\n          if ((err as Error).name === \'AbortError\' || sReqId !== summarySeqRef.current) return;\\n          // Surface summary error via actionsError only if actions also failed\\n          setActionsError((prev) => prev || (err instanceof Error ? err.message : \'Summary unavailable.\'));\\n        })\\n        .finally(() => {\\n          if (sReqId === summarySeqRef.current) {\\n            setSummaryLoading(false);\\n          }\\n        });\\n\\n      // 2) Fast parallel call for Tailored Daily Routines, Indoor Air Hacks & Sustainable Alternatives\\n      actionsAbortRef.current?.abort();\\n      const aController = new AbortController();\\n      actionsAbortRef.current = aController;\\n      const aReqId = ++actionsSeqRef.current;\\n      setActionsLoading(true);\\n      setActionsError(null);\\n\\n      fetch(\'/api/briefing/actions\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ snapshot: snap, profile: prof, forceRefresh }),\\n        signal: aController.signal,\\n      })\\n        .then(async (res) => {\\n          const data = (await res.json()) as BriefingActionsResponse & { error?: string };\\n          if (!res.ok) throw new Error(data.error || `Actions request failed (${res.status})`);\\n          if (aReqId !== actionsSeqRef.current) return;\\n          setRecommendations(data.recommendations ?? []);\\n        })\\n        .catch((err) => {\\n          if ((err as Error).name === \'AbortError\' || aReqId !== actionsSeqRef.current) return;\\n          setActionsError(\\n            err instanceof Error\\n              ? err.message\\n              : \'Unable to generate daily guidance right now.\'\\n          );\\n        })\\n        .finally(() => {\\n          if (aReqId === actionsSeqRef.current) {\\n            setActionsLoading(false);\\n          }\\n        });\\n    },\\n    []\\n  );\\n\\n  // Fetch live Open-Meteo data when location changes\\n  useEffect(() => {\\n    void fetchAir(location, false);\\n    return () => {\\n      airAbortRef.current?.abort();\\n    };\\n  }, [location, fetchAir]);\\n\\n  // Automatically regenerate structured summary + actions in parallel whenever snapshot or profile updates\\n  useEffect(() => {\\n    if (!snapshot) return;\\n    fetchSummaryAndActions(snapshot, profile, false);\\n    return () => {\\n      summaryAbortRef.current?.abort();\\n      actionsAbortRef.current?.abort();\\n    };\\n  }, [snapshot, profile, fetchSummaryAndActions]);\\n\\n  const handleSelectLocation = (nextLoc: LocationInfo) => {\\n    airAbortRef.current?.abort();\\n    summaryAbortRef.current?.abort();\\n    actionsAbortRef.current?.abort();\\n    setGeoError(null);\\n    setSnapshot(null);\\n    setSummaryData(null);\\n    setRecommendations([]);\\n    setActionsError(null);\\n    setLocation(nextLoc);\\n    try {\\n      localStorage.setItem(STORAGE_LOCATION_KEY, JSON.stringify(nextLoc));\\n    } catch {\\n      // ignore\\n    }\\n  };\\n\\n  const handleSaveProfile = (nextProfile: HouseholdProfile) => {\\n    setProfile(nextProfile);\\n    try {\\n      localStorage.setItem(STORAGE_PROFILE_KEY, JSON.stringify(nextProfile));\\n    } catch {\\n      // ignore\\n    }\\n  };\\n\\n  const handleToggleCommit = (id: string) => {\\n    setCommittedIds((prev) => {\\n      const next = prev.includes(id) ? prev.filter((item) => item !== id) : [...prev, id];\\n      try {\\n        localStorage.setItem(\\n          STORAGE_COMMIT_KEY,\\n          JSON.stringify({ date: getTodayKey(), ids: next })\\n        );\\n      } catch {\\n        // ignore\\n      }\\n      return next;\\n    });\\n  };\\n\\n  const handleUseGeolocation = () => {\\n    if (!(\'geolocation\' in navigator)) {\\n      setGeoError(\'Browser geolocation is not supported on this device. Use city search instead.\');\\n      return;\\n    }\\n    setIsLocating(true);\\n    setGeoError(null);\\n    navigator.geolocation.getCurrentPosition(\\n      async (position) => {\\n        const { latitude, longitude } = position.coords;\\n        let resolved: LocationInfo = {\\n          name: \'Current Location\',\\n          country: `${Math.abs(latitude).toFixed(2)}\302\260${latitude >= 0 ? \'N\' : \'S\'}, ${Math.abs(\\n            longitude\\n          ).toFixed(2)}\302\260${longitude >= 0 ? \'E\' : \'W\'}`,\\n          latitude,\\n          longitude,\\n        };\\n\\n        try {\\n          const res = await fetch(\\n            `/api/reverse-geocode?lat=${encodeURIComponent(\\n              String(latitude)\\n            )}&lon=${encodeURIComponent(String(longitude))}`\\n          );\\n          if (res.ok) {\\n            const payload = (await res.json()) as { location?: LocationInfo };\\n            if (payload.location) {\\n              resolved = payload.location;\\n            }\\n          }\\n        } catch {\\n          // fallback to coordinate label\\n        }\\n\\n        handleSelectLocation(resolved);\\n        setIsLocating(false);\\n      },\\n      (err) => {\\n        setGeoError(\\n          err.code === err.PERMISSION_DENIED\\n            ? \'Location permission was declined. Search your city (e.g., Kolkata) in the search box above.\'\\n            : \'Unable to determine your coordinates. Search your city above to load its live forecast.\'\\n        );\\n        setIsLocating(false);\\n      },\\n      { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }\\n    );\\n  };\\n\\n  const combinedBriefing: DailyBriefing | null =\\n    summaryData || recommendations.length > 0\\n      ? {\\n          generatedAt: summaryData?.generatedAt ?? new Date().toISOString(),\\n          headlineSummary: summaryData?.headlineSummary ?? \'\',\\n          inversionExplanation: summaryData?.inversionExplanation ?? \'\',\\n          alert: summaryData?.alert ?? {\\n            active: false,\\n            severityLabel: snapshot?.current.bandLabel ?? \'\',\\n            headline: snapshot?.current.advisorySummary ?? \'\',\\n            immediateActions: [],\\n          },\\n          activityNotes: summaryData?.activityNotes ?? [],\\n          recommendations,\\n        }\\n      : null;\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#F7F5F0] text-[#181715]\\\">\\n      <TopBar onOpenProfile={() => setProfileOpen(true)} />\\n\\n      <LocationToolbar\\n        location={location}\\n        observationTime={snapshot?.current.time}\\n        timezone={snapshot?.timezone}\\n        isLoading={airLoading}\\n        onSelectLocation={handleSelectLocation}\\n        onUseGeolocation={handleUseGeolocation}\\n        isLocating={isLocating}\\n        geoError={geoError}\\n        onRefresh={() => void fetchAir(location, true)}\\n      />\\n\\n      <main className=\\\"mx-auto max-w-[1240px] space-y-8 px-4 py-8 sm:px-6 lg:px-8\\\">\\n        {airError ? (\\n          <div\\n            role=\\\"alert\\\"\\n            className=\\\"rounded-md border border-[#E2BDBD] bg-[#F9EFEF] p-6\\\"\\n          >\\n            <h1 className=\\\"text-base font-semibold text-[#7F1D1D]\\\">\\n              Open-Meteo data unavailable\\n            </h1>\\n            <p className=\\\"mt-1 text-sm text-[#5E5A52]\\\">{airError}</p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => void fetchAir(location, true)}\\n              className=\\\"mt-4 inline-flex h-10 items-center rounded-md bg-[#181715] px-4 py-2 text-sm font-medium text-white hover:bg-[#33312E] cursor-pointer\\\"\\n            >\\n              Retry forecast fetch\\n            </button>\\n          </div>\\n        ) : airLoading && !snapshot ? (\\n          <div className=\\\"space-y-6\\\" aria-label={`Loading atmospheric observations for ${location.name}`}>\\n            <p className=\\\"text-xs font-medium text-[#5E5A52]\\\">\\n              Loading live Open-Meteo readings for {location.name}...\\n            </p>\\n            <div className=\\\"grid grid-cols-1 gap-6 lg:grid-cols-12\\\">\\n              <div className=\\\"lg:col-span-7 h-72 rounded-md border border-[#E2DDD3] bg-white p-6 space-y-4\\\">\\n                <div className=\\\"h-5 w-48 rounded bg-[#EFECE6]\\\" />\\n                <div className=\\\"h-14 w-32 rounded bg-[#EFECE6]\\\" />\\n                <div className=\\\"h-4 w-full rounded bg-[#F7F5F0]\\\" />\\n                <div className=\\\"h-4 w-3/4 rounded bg-[#F7F5F0]\\\" />\\n              </div>\\n              <div className=\\\"lg:col-span-5 h-72 rounded-md border border-[#E2DDD3] bg-white p-6 space-y-3\\\">\\n                <div className=\\\"h-5 w-40 rounded bg-[#EFECE6]\\\" />\\n                <div className=\\\"h-7 w-full rounded bg-[#F7F5F0]\\\" />\\n                <div className=\\\"h-7 w-full rounded bg-[#F7F5F0]\\\" />\\n                <div className=\\\"h-7 w-full rounded bg-[#F7F5F0]\\\" />\\n                <div className=\\\"h-7 w-full rounded bg-[#F7F5F0]\\\" />\\n              </div>\\n            </div>\\n            <div className=\\\"h-80 rounded-md border border-[#E2DDD3] bg-white p-6\\\" />\\n          </div>\\n        ) : snapshot ? (\\n          <>\\n            <AirOverviewHero\\n              snapshot={snapshot}\\n              briefing={summaryData ? combinedBriefing : null}\\n              briefingLoading={summaryLoading}\\n            />\\n\\n            <ForecastChart\\n              key={`${snapshot.location.latitude.toFixed(3)}-${snapshot.location.longitude.toFixed(3)}`}\\n              hourly={snapshot.hourly}\\n              currentTime={snapshot.current.time}\\n            />\\n\\n            <ActivityPlanner\\n              activities={snapshot.activities}\\n              activityNotes={summaryData?.activityNotes ?? []}\\n            />\\n\\n            <DailyBriefingLedger\\n              locationName={snapshot.location.name}\\n              briefing={combinedBriefing}\\n              loading={actionsLoading}\\n              error={actionsError}\\n              profile={profile}\\n              committedIds={committedIds}\\n              onToggleCommit={handleToggleCommit}\\n              onRetry={() => fetchSummaryAndActions(snapshot, profile, true)}\\n              onOpenProfile={() => setProfileOpen(true)}\\n            />\\n          </>\\n        ) : null}\\n      </main>\\n\\n      <footer className=\\\"mt-8 border-t border-[#E2DDD3] bg-[#F7F5F0]\\\">\\n        <div className=\\\"mx-auto flex max-w-[1240px] flex-col gap-2 px-4 py-6 text-xs text-[#5E5A52] sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8\\\">\\n          <p>\\n            Air Almanac \342\200\224 Atmospheric &amp; particulate forecasts via Open-Meteo; thresholds aligned with WHO 2021 Air Quality Guidelines.\\n          </p>\\n          <p className=\\\"text-[#847F75]\\\">\\n            Informational civic guidance; follow local medical and municipal advisories during severe smog episodes.\\n          </p>\\n        </div>\\n      </footer>\\n\\n      <ProfileDrawer\\n        open={profileOpen}\\n        profile={profile}\\n        onClose={() => setProfileOpen(false)}\\n        onSave={handleSaveProfile}\\n      />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Invoke /api/briefing/summary and /api/briefing/actions in parallel with strict AbortController guards so Today\'s Briefing Summary and Tailored Actions populate quickly without stale city bleed\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring parallel fast summary and actions in App.tsx\", \"toolSummary\":\"Wire parallel briefing in App.tsx\"}"
      original_name: "write_to_file"
    }
