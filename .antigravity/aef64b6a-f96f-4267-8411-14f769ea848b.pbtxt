            arguments_json: "{\"CommandLine\":\"sleep 2 && curl -s \\\"http://localhost:3000/api/air-data?lat=22.5726&lon=88.3639&name=Kolkata&admin1=West%20Bengal&country=India\\\" > /tmp/kol.json && node -e \\\"const fs=require(\'fs\'); const s=JSON.parse(fs.readFileSync(\'/tmp/kol.json\',\'utf8\')); const body=JSON.stringify({snapshot:s, profile:{sensitivity:\'children\',commute:\'car\',heatingCooking:\'gas\',indoorSetup:\'natural_ventilation\',householdSize:4}}); const t0=Date.now(); Promise.all([fetch(\'http://localhost:3000/api/briefing/summary\',{method:\'POST\',headers:{\'Content-Type\':\'application/json\'},body}).then(async r=>({ep:\'summary\',status:r.status,ms:Date.now()-t0,data:await r.json()})), fetch(\'http://localhost:3000/api/briefing/actions\',{method:\'POST\',headers:{\'Content-Type\':\'application/json\'},body}).then(async r=>({ep:\'actions\',status:r.status,ms:Date.now()-t0,data:await r.json()}))]).then(res=>{for(const x of res){console.log(x.ep, \'HTTP\', x.status, x.ms+\'ms\', x.ep===\'summary\'?x.data.headlineSummary:\'count=\'+x.data.recommendations?.length+\' first=\'+x.data.recommendations?.[0]?.title);}}).finally(()=>fs.unlinkSync(\'/tmp/kol.json\'));\\\"\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Benchmarking parallel Kolkata briefing endpoints\", \"toolSummary\":\"Benchmark parallel Kolkata briefing\"}"
