  code_action {
    action_spec {
      create_file {
        instruction: "import \'dotenv/config\';\nimport express from \'express\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { createServer as createViteServer } from \'vite\';\nimport { DEFAULT_LOCATION, fetchAtmosphericData, searchCities } from \'./server/openMeteo.ts\';\nimport { generateDailyBriefing } from \'./server/geminiBriefing.ts\';\nimport type { AtmosphericSnapshot, HouseholdProfile, LocationInfo } from \'./src/types/air.ts\';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nasync function startServer() {\n  const app = express();\n  const PORT = Number(process.env.PORT) || 3000;\n\n  app.use(express.json({ limit: \'1mb\' }));\n\n  app.get(\'/api/health\', (_req, res) => {\n    res.json({ status: \'ok\' });\n  });\n\n  app.get(\'/api/geocode\', async (req, res) => {\n    try {\n      const q = typeof req.query.q === \'string\' ? req.query.q : \'\';\n      const results = await searchCities(q);\n      res.json({ results });\n    } catch (err) {\n      const message = err instanceof Error ? err.message : \'Unable to search locations.\';\n      res.status(502).json({ error: message });\n    }\n  });\n\n  app.get(\'/api/air-data\', async (req, res) => {\n    try {\n      const latRaw = Number(req.query.lat);\n      const lonRaw = Number(req.query.lon);\n      const hasCoords = Number.isFinite(latRaw) && Number.isFinite(lonRaw);\n\n      const location: LocationInfo = hasCoords\n        ? {\n            name: typeof req.query.name === \'string\' && req.query.name.trim()\n              ? req.query.name.trim()\n              : `${latRaw.toFixed(2)}, ${lonRaw.toFixed(2)}`,\n            admin1: typeof req.query.admin1 === \'string\' && req.query.admin1.trim()\n              ? req.query.admin1.trim()\n              : undefined,\n            country: typeof req.query.country === \'string\' && req.query.country.trim()\n              ? req.query.country.trim()\n              : \'Local Coordinates\',\n            latitude: latRaw,\n            longitude: lonRaw,\n          }\n        : DEFAULT_LOCATION;\n\n      const bypassCache = req.query.refresh === \'1\';\n      const snapshot = await fetchAtmosphericData(location, bypassCache);\n      res.json(snapshot);\n    } catch (err) {\n      const message =\n        err instanceof Error ? err.message : \'Unable to fetch Open-Meteo air quality data.\';\n      res.status(502).json({ error: message });\n    }\n  });\n\n  app.post(\'/api/briefing\', async (req, res) => {\n    try {\n      const { snapshot, profile } = req.body as {\n        snapshot?: AtmosphericSnapshot;\n        profile?: HouseholdProfile;\n      };\n\n      if (!snapshot || !snapshot.current || !profile) {\n        res.status(400).json({ error: \'Both atmospheric snapshot and household profile are required.\' });\n        return;\n      }\n\n      const briefing = await generateDailyBriefing(snapshot, profile);\n      res.json(briefing);\n    } catch (err) {\n      const rawMessage = err instanceof Error ? err.message : \'Failed to generate daily briefing.\';\n      let status = 500;\n      let userMessage = rawMessage;\n\n      if (rawMessage.includes(\'API_KEY_INVALID\') || rawMessage.includes(\'PERMISSION_DENIED\')) {\n        status = 403;\n        userMessage =\n          \'Gemini API key error. Please verify your API key in Settings > Secrets.\';\n      } else if (rawMessage.includes(\'RESOURCE_EXHAUSTED\') || rawMessage.includes(\'429\')) {\n        status = 429;\n        userMessage =\n          \'Gemini API rate limit reached. Please retry in a few seconds or check your API key quota in Settings > Secrets.\';\n      } else if (rawMessage.includes(\'GEMINI_API_KEY is not configured\')) {\n        status = 503;\n        userMessage = rawMessage;\n      }\n\n      res.status(status).json({ error: userMessage });\n    }\n  });\n\n  const isProd = process.env.NODE_ENV === \'production\';\n  if (!isProd) {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distDir = path.resolve(__dirname, \'dist\');\n    app.use(express.static(distDir));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.join(distDir, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Air Almanac server listening on http://localhost:${PORT}`);\n  });\n}\n\nstartServer().catch((err) => {\n  console.error(\'Failed to start Air Almanac server:\', err);\n  process.exit(1);\n});\n"
        path {
          absolute_uri: "file:///server.ts"
        }
        overwrite: true
      }
    }
