  generic {
    args {
      key: "questions"
      value: "[{\"question\":\"Which minimalist visual aesthetic feels most authentic and non-generic for the dashboard?\",\"options\":[\"(Recommended) Nordic Civic Instrument (Warm Stone and Ink)\",\"Swiss Almanac (Crisp White and Signal Amber)\",\"Atmospheric Slate (Matte Charcoal Dark Mode)\",\"Botanical Journal (Soft Paper and Forest Slate)\"]},{\"question\":\"We will integrate Open-Meteo real-time weather and air quality APIs. Which default fallback city should load before users search or share location?\",\"options\":[\"(Recommended) Global with auto-detect and city search (Delhi default)\",\"Global with auto-detect and city search (London default)\",\"Global with auto-detect and city search (Beijing default)\",\"Global with auto-detect and city search (New York default)\"]},{\"question\":\"Which combination of tailored features should we prioritize in the dashboard?\",\"options\":[\"(Recommended) Family routines, indoor hacks, and impact calculator\",\"Family health advisor plus community pledge board\",\"Streamlined daily briefing and safe activity planner\"]},{\"question\":\"How should the GenAI guidance appear within the interface?\",\"options\":[\"(Recommended) Actionable dashboard cards with contextual Q\\u0026A drawer\",\"Structured auto-generated guidance without chat UI\",\"Persistent side-by-side data and advisor split view\"]}]"
    }
