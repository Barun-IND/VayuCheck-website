            lines {
              text: "- **Visual Direction (Confirmed)**: Nordic Civic Instrument \342\200\224 Warm Stone canvas (`#F7F5F0`), crisp flat white/stone surfaces, 1px hairline dividers, Ink (`#181715`) typography, tabular numerals, and zero AI-clich\303\251 gradients, floating pill badges, or chat clutter."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
