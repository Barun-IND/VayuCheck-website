            lines {
              text: "- **Core Scope (Confirmed)**: Streamlined daily briefing and safe activity planner \342\200\224 real-time smog alerts, 48-hour hourly pollution & wind-dispersion charts, safest-window activity timeline, tailored low-emission routine swaps, indoor air quality hacks, and direct exposure/emission impact explanations."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
