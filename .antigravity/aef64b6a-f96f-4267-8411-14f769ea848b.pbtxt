      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Show crisp city-specific loading status in Today\'s Briefing Summary inside AirOverviewHero\", \"EndLine\":120, \"Instruction\":\"Show generating status text alongside subtle skeleton while Today\'s Briefing Summary loads for the active city\", \"ReplacementContent\":\"              <div className=\\\"sm:col-span-7 border-t border-[#EFECE6] pt-4 sm:border-t-0 sm:border-l sm:pl-6 sm:pt-0\\\">\\n                <div className=\\\"flex items-center justify-between gap-2\\\">\\n                  <p className=\\\"text-xs font-medium text-[#5E5A52]\\\">Today&apos;s Briefing Summary</p>\\n                  {briefingLoading && (\\n                    <span className=\\\"text-[11px] text-[#847F75]\\\">\\n                      Updating for {snapshot.location.name}...\\n                    </span>\\n                  )}\\n                </div>\\n                {briefingLoading && !briefing ? (\\n                  <div className=\\\"mt-2 space-y-2\\\" aria-label={`Generating summary for ${snapshot.location.name}`}>\\n                    <div className=\\\"h-3.5 w-full rounded bg-[#EFECE6]\\\" />\\n                    <div className=\\\"h-3.5 w-10/12 rounded bg-[#EFECE6]\\\" />\\n                  </div>\\n                ) : (\\n                  <p className=\\\"mt-1.5 text-sm leading-relaxed text-[#181715]\\\">\\n                    {briefing?.headlineSummary || current.advisorySummary}\\n                  </p>\\n                )}\\n              </div>\", \"StartLine\":100, \"TargetContent\":\"              <div className=\\\"sm:col-span-7 border-t border-[#EFECE6] pt-4 sm:border-t-0 sm:border-l sm:pl-6 sm:pt-0\\\">\\n                <p className=\\\"text-xs font-medium text-[#5E5A52]\\\">Today&apos;s Briefing Summary</p>\\n                {briefingLoading && !briefing ? (\\n                  <div className=\\\"mt-2 space-y-2\\\" aria-label=\\\"Loading tailored summary\\\">\\n                    <div className=\\\"h-3.5 w-full rounded bg-[#EFECE6]\\\" />\\n                    <div className=\\\"h-3.5 w-11/12 rounded bg-[#EFECE6]\\\" />\\n                    <div className=\\\"h-3.5 w-3/4 rounded bg-[#EFECE6]\\\" />\\n                  </div>\\n                ) : (\\n                  <p className=\\\"mt-1.5 text-sm leading-relaxed text-[#181715]\\\">\\n                    {briefing?.headlineSummary || current.advisorySummary}\\n                  </p>\\n                )}\\n              </div>\", \"TargetFile\":\"/src/components/AirOverviewHero.tsx\", \"toolAction\":\"Updating AirOverviewHero loading indicator\", \"toolSummary\":\"Update AirOverviewHero status\"}"
