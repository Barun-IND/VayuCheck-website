        instruction: "export interface LocationInfo {\n  name: string;\n  admin1?: string;\n  country: string;\n  latitude: number;\n  longitude: number;\n  timezone?: string;\n}\n\nexport type AqiBand =\n  | \'good\'\n  | \'moderate\'\n  | \'sensitive\'\n  | \'unhealthy\'\n  | \'very_unhealthy\'\n  | \'hazardous\';\n\nexport type InversionRiskLevel = \'low\' | \'moderate\' | \'high\';\n\nexport interface HourlyPoint {\n  time: string;\n  hourLabel: string;\n  dayIndex: 0 | 1;\n  usAqi: number;\n  europeanAqi: number;\n  pm25: number;\n  pm10: number;\n  no2: number;\n  o3: number;\n  so2: number;\n  co: number;\n  temperature: number;\n  humidity: number;\n  windSpeed: number;\n  visibilityKm: number;\n}\n\nexport interface PollutantBreakdown {\n  key: \'pm25\' | \'pm10\' | \'no2\' | \'o3\' | \'so2\' | \'co\';\n  label: string;\n  formula: string;\n  value: number;\n  unit: string;\n  whoLimit: number;\n  whoNote: string;\n  ratioToWho: number;\n  status: \'within\' | \'elevated\' | \'high\' | \'severe\';\n}\n\nexport type ActivityRating = \'recommended\' | \'caution\' | \'limit\' | \'avoid\';\n\nexport interface ActivityWindow {\n  id: string;\n  activity: string;\n  dayIndex: 0 | 1;\n  bestWindow: string;\n  windowAvgAqi: number;\n  windowAvgPm25: number;\n  rating: ActivityRating;\n  ratingLabel: string;\n  protectionNote: string;\n  rationale: string;\n}\n\nexport interface AtmosphericSnapshot {\n  location: LocationInfo;\n  fetchedAt: string;\n  timezone: string;\n  current: {\n    time: string;\n    usAqi: number;\n    europeanAqi: number;\n    band: AqiBand;\n    bandLabel: string;\n    advisorySummary: string;\n    dominantPollutant: string;\n    pm25: number;\n    pm10: number;\n    no2: number;\n    o3: number;\n    so2: number;\n    co: number;\n    whoPm25Multiple: number;\n    temperature: number;\n    humidity: number;\n    windSpeed: number;\n    visibilityKm: number;\n    surfacePressure: number;\n  };\n  inversion: {\n    risk: InversionRiskLevel;\n    label: string;\n    summary: string;\n  };\n  bestVentilationWindow: {\n    windowLabel: string;\n    avgAqi: number;\n    avgPm25: number;\n    advisable: boolean;\n  };\n  pollutants: PollutantBreakdown[];\n  hourly: HourlyPoint[];\n  activities: ActivityWindow[];\n}\n\nexport type SensitivityGroup = \'general\' | \'children\' | \'seniors\' | \'respiratory\';\nexport type CommuteMode = \'car\' | \'two_wheeler\' | \'transit\' | \'walk_cycle\';\nexport type HeatingCookingSetup = \'gas\' | \'electric\' | \'solid_fuel\';\nexport type IndoorAirSetup = \'hepa_purifier\' | \'ac_filter\' | \'natural_ventilation\';\n\nexport interface HouseholdProfile {\n  sensitivity: SensitivityGroup;\n  commute: CommuteMode;\n  heatingCooking: HeatingCookingSetup;\n  indoorSetup: IndoorAirSetup;\n  householdSize: number;\n}\n\nexport type RecommendationCategory =\n  | \'routine\'\n  | \'indoor_hack\'\n  | \'sustainable_alternative\';\n\nexport interface BriefingRecommendation {\n  id: string;\n  category: RecommendationCategory;\n  title: string;\n  effort: \'Low effort\' | \'Medium effort\' | \'Habit shift\';\n  timeframe: string;\n  steps: string[];\n  directHealthImpact: string;\n  directEmissionImpact: string;\n  scientificMechanism: string;\n  estimatedCo2KgSaved: number;\n  estimatedExposureDropPct: number;\n}\n\nexport interface ActivityGuidanceNote {\n  activityId: string;\n  tailoredTip: string;\n}\n\nexport interface DailyBriefing {\n  generatedAt: string;\n  headlineSummary: string;\n  inversionExplanation: string;\n  alert: {\n    active: boolean;\n    severityLabel: string;\n    headline: string;\n    immediateActions: string[];\n  };\n  activityNotes: ActivityGuidanceNote[];\n  recommendations: BriefingRecommendation[];\n}\n"
